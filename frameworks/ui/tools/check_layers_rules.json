{
  "_note": "클라이언트 계층 규칙(check_layers.py 가 읽는다). 층별 금지 프로젝트 참조·패키지·코드 패턴과 신규 층 파일의 줄 수·헤더 규칙. required=true 층은 프로젝트가 없으면 위반이다.",
  "src_root": "src",
  "scan_paths": ["src", "tools", "testbed"],
  "skip_dirs": ["bin", "obj", ".vs", "node_modules", "__pycache__"],
  "layers": {
    "xkxk.frameworks.ui": {
      "required": true,
      "forbid_projects": ["xkxk.frameworks.ui.shell", "xkxk.frameworks.ui.data", "xkxk.frameworks.ui.views", "xkxk.frameworks.ui.hosting.desktop", "xkxk.frameworks.ui.hosting.browser", "xkxk.frameworks.ui.hosting.android", "xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "allow_packages": { "Avalonia": "12.1.4" },
      "forbid_code": ["\\bxkxk\\.frameworks\\.ui\\.(shell|hosting|desktop|browser|android|data|views|testbed)\\b", "\\busing\\s+Dock\\."]
    },
    "xkxk.frameworks.ui.views": {
      "required": true,
      "forbid_projects": ["xkxk.frameworks.ui.hosting.desktop", "xkxk.frameworks.ui.hosting.browser", "xkxk.frameworks.ui.hosting.android", "xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "_note_avares": "벤치 글꼴 후보가 호스트 자원을 avares URI 문자열로 찾는 것은 형식 참조가 아니라 허용한다",
      "forbid_code": ["(?<!avares://)\\bxkxk\\.frameworks\\.ui\\.(hosting|desktop|browser|android|testbed)\\b"]
    },
    "xkxk.frameworks.ui.shell": {
      "required": true,
      "forbid_projects": ["xkxk.frameworks.ui.views", "xkxk.frameworks.ui.hosting.desktop", "xkxk.frameworks.ui.hosting.browser", "xkxk.frameworks.ui.hosting.android", "xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "forbid_exts": [".axaml"],
      "_note_parts": "템플릿 부품 이름은 xkxk.frameworks.ui 의 TemplateParts 상수로만 쓴다(문자열 리터럴·조합 금지). 주석 언급은 허용",
      "forbid_code": ["\\bxkxk\\.frameworks\\.ui\\.(views|hosting|testbed)\\b", "\\bPART_"]
    },
    "xkxk.frameworks.ui.data": {
      "required": true,
      "forbid_projects": ["xkxk.frameworks.ui.shell", "xkxk.frameworks.ui", "xkxk.frameworks.ui.views", "xkxk.frameworks.ui.hosting.desktop", "xkxk.frameworks.ui.hosting.browser", "xkxk.frameworks.ui.hosting.android", "xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "forbid_packages": ["Avalonia"],
      "forbid_code": ["\\bAvalonia\\b", "\\bxkxk\\.frameworks\\.ui\\b(?!\\.data\\b)"]
    },
    "xkxk.frameworks.ui.hosting.desktop": {
      "required": false,
      "_note": "호스팅 라이브러리(B11, UADR-0018). 시험대 참조 금지. required=false 는 check_layers.py --self-test 의 최소 고정물에 이 프로젝트가 없어서이다. 공개 형식 수·InternalsVisibleTo 는 시험과 consumer_rules 가 맡는다.",
      "forbid_projects": ["xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "forbid_code": ["\\bxkxk\\.frameworks\\.ui\\.testbed\\b"]
    },
    "xkxk.frameworks.ui.hosting.browser": {
      "required": false,
      "forbid_projects": ["xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "forbid_code": ["\\bxkxk\\.frameworks\\.ui\\.testbed\\b"]
    },
    "xkxk.frameworks.ui.hosting.android": {
      "required": false,
      "forbid_projects": ["xkxk.frameworks.ui.testbed", "xkxk.frameworks.ui.testbed.desktop", "xkxk.frameworks.ui.testbed.browser", "xkxk.frameworks.ui.testbed.android"],
      "forbid_code": ["\\bxkxk\\.frameworks\\.ui\\.testbed\\b"]
    },
    "xkxk.frameworks.ui.testbed": {
      "_note": "시험대는 프레임워크 모든 층을 공개 형식으로 소비하는 최상위 앱이라 참조·패키지·코드 금지가 없다. Internal·NonPublic 금지는 consumer_rules 가 건다.",
      "path": "testbed/xkxk.frameworks.ui.testbed",
      "required": false,
      "forbid_projects": []
    }
  },
  "template_parts": {
    "_note": "contract 의 상수 이름이 definer 층 axaml 의 Name 정의나 dock_packages 의 DLL(버전은 version_from 의 PackageReference)에 실재해야 한다. DLL 을 못 찾으면 통과가 아니라 위반이다.",
    "contract": "src/xkxk.frameworks.ui/Controls/TemplateParts.cs",
    "definer": "xkxk.frameworks.ui.views",
    "version_from": "src/xkxk.frameworks.ui.shell/xkxk.frameworks.ui.shell.csproj",
    "dock_packages": ["Dock.Avalonia", "Dock.Avalonia.Themes.Fluent"],
    "dock_tfm": "net10.0"
  },
  "consumer_rules": {
    "_note": "프레임워크 소비 경계(check_layers_consumer.py). framework_paths 에서 InternalsVisibleTo 를 금지하고, 활성 소비자 경로에서 Internal 네임스페이스·NonPublic 리플렉션을 금지한다. 경로가 없으면 건너뛴다.",
    "framework_paths": ["src"],
    "framework_forbid_code": ["\\bInternalsVisibleTo\\b"],
    "consumers": [
      { "path": "test/framework", "active": true },
      { "path": "testbed", "active": true }
    ],
    "consumer_forbid_code": ["\\bxkxk\\.frameworks\\.ui(\\.[A-Za-z0-9_]+)*\\.Internal\\b", "\\bBindingFlags\\.NonPublic\\b"],
    "exts": [".cs", ".csproj"]
  },
  "new_files": {
    "prefixes": ["src/xkxk.frameworks.ui/", "src/xkxk.frameworks.ui.views/", "src/xkxk.frameworks.ui.data/", "tools/check_layers.py", "tools/check_layers_parts.py", "tools/check_layers_consumer.py", "tools/classify_layers.py", "src/xkxk.frameworks.ui.shell/Framework/", "src/xkxk.frameworks.ui.hosting.desktop/", "src/xkxk.frameworks.ui.hosting.browser/", "src/xkxk.frameworks.ui.hosting.android/", "testbed/"],
    "max_lines": 300,
    "exts": [".cs", ".axaml", ".csproj", ".py"],
    "exempt": []
  },
  "line_limit_only": {
    "_note": "기존 층 파일이라 헤더 규칙은 면제하되 줄 수 상한만 건다(소스 분할 라운드 2). 코드·화면 파일이 대상이다.",
    "prefixes": ["src/xkxk.frameworks.ui.shell/"],
    "max_lines": 300,
    "exts": [".cs", ".axaml"]
  }
}
