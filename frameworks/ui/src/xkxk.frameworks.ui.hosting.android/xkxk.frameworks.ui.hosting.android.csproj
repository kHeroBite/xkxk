<!-- 별별UI Android 호스트 라이브러리 — 기반 Application·Activity·시작 보조를 공개하고 [Application]·[Activity] 특성과 리소스는 실행 프로젝트가 둔다(UADR-0018) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Avalonia.Android 12.1.4 nuspec 대상 = net10.0-android36.0, 설치 워크로드 android 36.1.43(2026-10-28 실측) -->
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>xkxk.frameworks.ui.hosting.android</RootNamespace>
    <AssemblyName>xkxk.frameworks.ui.hosting.android</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- SDK·JDK 경로: 실행 프로젝트와 같은 규칙(환경변수 PD_ANDROID_SDK·PD_JAVA_SDK, 없으면 이 PC 실측 경로) -->
    <AndroidSdkDirectory Condition="'$(PD_ANDROID_SDK)' != ''">$(PD_ANDROID_SDK)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(PD_ANDROID_SDK)' == '' and Exists('C:\Program Files (x86)\Android\android-sdk')">C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(PD_JAVA_SDK)' != ''">$(PD_JAVA_SDK)</JavaSdkDirectory>
    <JavaSdkDirectory Condition="'$(PD_JAVA_SDK)' == '' and Exists('C:\Program Files\Android\openjdk\jdk-21.0.8')">C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\xkxk.frameworks.ui.shell\xkxk.frameworks.ui.shell.csproj" />
    <ProjectReference Include="..\xkxk.frameworks.ui.data\xkxk.frameworks.ui.data.csproj" />
    <ProjectReference Include="..\xkxk.frameworks.ui\xkxk.frameworks.ui.csproj" />
  </ItemGroup>
</Project>
