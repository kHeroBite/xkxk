<!-- 웹 글꼴 전용 어셈블리(코드 없음) — 임베드 한글 글꼴만 담아, 앱 코드가 바뀌어도 이 어셈블리의 내용 해시가 그대로라 브라우저 캐시를 다시 쓴다(odev-wtrim, 2026-11-06 lead 결정 A) -->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- 사용: xkxk.frameworks.ui.browser 가 PdFontAssembly=true(기본)일 때만 참조한다. -p:PdFontAssembly=false 면 예전처럼 xkxk.frameworks.ui.browser 안에 임베드한다.
       avares 경로: avares://xkxk.frameworks.ui.fonts/Assets/Fonts#Noto Sans KR (Avalonia 문서 EmbeddedFontCollection·avares 방식 — docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-fonts)
       글꼴 원본은 옮기지 않는다: Android·벤치가 같은 파일을 링크로 쓰므로 xkxk.frameworks.ui.browser/Assets/Fonts 의 파일을 Link 로 가져온다(사본 없음).
       코드가 없어 트리머가 어셈블리를 지우지 않도록 xkxk.frameworks.ui.browser.csproj 에 TrimmerRootAssembly 를 둔다(avares 는 문자열 URI 라 형식 참조가 없다). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>xkxk.frameworks.ui.fonts</RootNamespace>
    <AssemblyName>xkxk.frameworks.ui.fonts</AssemblyName>
  </PropertyGroup>

  <!-- 재현 가능한 빌드(odev-r2-build): 같은 입력이면 같은 어셈블리 해시가 나오게 한다. 브라우저 캐시가 어셈블리 해시를 키로 쓰기 때문이다.
       Deterministic: .NET SDK 기본값이 true 이나 명시한다(learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#deterministic).
       ContinuousIntegrationBuild·PathMap: 저장 경로를 정규화하므로 로컬 디버거가 소스를 못 찾고 중단점이 안 걸린다
       (learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#continuousintegrationbuild, learn.microsoft.com/dotnet/csharp/language-reference/compiler-options/advanced#pathmap).
       그래서 Release 구성에서만 켜서 Debug 개발 경험은 건드리지 않는다. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))=/_/xkxk.frameworks.ui.fonts/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- AvaloniaResource 처리(!AvaloniaResources 내장)에 Avalonia 빌드 작업이 필요하다. 버전은 다른 프로젝트와 같게 맞춘다 -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 포함 범위는 기존 xkxk.frameworks.ui.browser 임베드와 같다(*.ttf) -->
    <AvaloniaResource Include="..\xkxk.frameworks.ui.browser\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
