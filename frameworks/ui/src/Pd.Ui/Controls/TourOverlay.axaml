<!-- 도움말 투어 오버레이(요건 6) — 창 전체를 어둡게 덮고 대상에 스포트라이트 구멍·맥박 링을 두며 호출 카드나 마지막 레이어를 띄운다. 투명 바탕이 구멍 위 포인터까지 받는다 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Pd.Ui.Controls"
             x:Class="Pd.Ui.Controls.TourOverlay"
             Background="Transparent"
             AutomationProperties.AutomationId="tour.overlay">
  <UserControl.Styles>
    <Style Selector="Border#Ring.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ctl|TourCard.fadein">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Panel>
    <Path x:Name="Dim" Fill="{DynamicResource PdBrushWindowShadow}" IsHitTestVisible="False" />
    <Canvas x:Name="Stage">
      <Border x:Name="Ring" BorderBrush="{DynamicResource PdBrushAccent}" BorderThickness="2" CornerRadius="6"
              IsHitTestVisible="False" AutomationProperties.AutomationId="tour.ring" />
      <ctl:TourCard x:Name="Card" />
    </Canvas>
    <ctl:ShortcutLayer x:Name="Shortcuts" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
  </Panel>
</UserControl>
