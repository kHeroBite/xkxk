<!-- 도움말 투어 마지막 레이어(요건 6) — 화면이 아닌 단축키·기능·문의 안내를 자세히 보여 준다. 행 데이터는 상위 층이 넣고 색은 테마 토큰만 쓴다 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Pd.Ui.Controls"
             x:Class="Pd.Ui.Controls.ShortcutLayer"
             AutomationProperties.AutomationId="tour.shortcuts">
  <Border Background="{DynamicResource PdBrushSurface}" BorderBrush="{DynamicResource PdBrushAccent}" BorderThickness="1"
          CornerRadius="8" Padding="16,12">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="HeaderText" VerticalAlignment="Center" FontSize="16" FontWeight="{DynamicResource PdFontWeightStrong}"
                   Foreground="{DynamicResource PdBrushText}" AutomationProperties.AutomationId="tour.shortcuts.title" />
        <Button x:Name="BtnX" Grid.Column="1" Padding="8,6" Background="Transparent" Click="OnClose" AutomationProperties.AutomationId="tour.layer.btnX">
          <PathIcon Width="10" Height="10" Data="{DynamicResource PdGlyphClose}" />
        </Button>
      </Grid>
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,12,0,0">
        <TextBlock x:Name="CounterText" VerticalAlignment="Center" Foreground="{DynamicResource PdBrushTextMuted}"
                   AutomationProperties.AutomationId="tour.layer.counter" />
        <Button x:Name="BtnPrev" Grid.Column="2" Click="OnPrevious" AutomationProperties.AutomationId="tour.layer.btnPrev" />
        <Button x:Name="BtnClose" Grid.Column="3" Click="OnClose" Background="{DynamicResource PdBrushAccent}"
                Foreground="{DynamicResource PdBrushAccentText}" AutomationProperties.AutomationId="tour.layer.btnClose" />
      </Grid>
      <!-- 창보다 내용이 길면 스크롤한다. 잘린 내용이 더 있음을 알 수 있게 스크롤바를 숨기지 않는다 -->
      <ScrollViewer x:Name="LayerScroll" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" AutomationProperties.AutomationId="tour.layer.scroll">
        <StackPanel Spacing="4" Margin="0,0,10,0">
          <TextBlock x:Name="KeysHeader" FontWeight="{DynamicResource PdFontWeightStrong}" Foreground="{DynamicResource PdBrushText}" />
          <ItemsControl x:Name="KeyList" AutomationProperties.AutomationId="tour.layer.keys">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ctl:ShortcutRowItem">
                <Grid ColumnDefinitions="130,*" ColumnSpacing="12" Margin="0,2" AutomationProperties.AutomationId="{Binding AutomationId}">
                  <TextBlock Text="{Binding Keys}" FontWeight="{DynamicResource PdFontWeightStrong}" Foreground="{DynamicResource PdBrushAccent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource PdBrushText}" />
                    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" Foreground="{DynamicResource PdBrushWarning}"
                               AutomationProperties.AutomationId="{Binding NoteAutomationId}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="FeaturesHeader" Margin="0,10,0,0" FontWeight="{DynamicResource PdFontWeightStrong}" Foreground="{DynamicResource PdBrushText}" />
          <ItemsControl x:Name="FeatureList" AutomationProperties.AutomationId="tour.layer.features">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ctl:FeatureRowItem">
                <StackPanel Margin="0,2" AutomationProperties.AutomationId="{Binding AutomationId}">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PdBrushAccent}" />
                  <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Foreground="{DynamicResource PdBrushText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ContactHeader" Margin="0,10,0,0" FontWeight="{DynamicResource PdFontWeightStrong}" Foreground="{DynamicResource PdBrushText}" />
          <TextBlock x:Name="ContactBody" TextWrapping="Wrap" Foreground="{DynamicResource PdBrushText}" AutomationProperties.AutomationId="tour.layer.contact" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
