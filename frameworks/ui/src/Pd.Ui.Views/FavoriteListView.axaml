<!-- 세로 즐겨찾기 구역(REQ-113, 09/22 §4.4·09/20 §4) — 모바일형 삼선 메뉴 맨 위와 탐색 패널 맨 위. 0개면 숨김, 누름=활성화 또는 열기, 우클릭·길게 누르기=빼기. 데이터·명령은 제목 줄과 같은 FavoriteBarViewModel -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pd.Poc.Shell.ViewModels"
             xmlns:views="using:Pd.Ui.Views"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             x:Class="Pd.Ui.Views.FavoriteListView"
             x:DataType="vm:FavoriteBarViewModel"
             IsVisible="{Binding HasItems, FallbackValue=False}"
             AutomationProperties.AutomationId="shell.favoriteList">
  <StackPanel Spacing="4">
    <TextBlock Text="{loc:Tr favorite.title}" FontWeight="{DynamicResource PdFontWeightStrong}" Margin="4,4,4,0" />
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FavoriteItem">
          <!-- 명령은 코드 비하인드로 넘긴다: 조상 형 이름을 실행 중에 푸는 ReflectionBinding 은 웹·Android 에서 죽는다 -->
          <Button Click="OnItemClick" MinHeight="44" Padding="10,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Center" Background="Transparent"
                  AutomationProperties.AutomationId="{Binding ScreenId, StringFormat='shell.favoriteList.{0}'}" AutomationProperties.Name="{Binding Title}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <views:WindowIcon IconKey="{Binding IconKey}" FallbackText="{Binding Title}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{loc:Tr favorite.remove}" Click="OnRemoveClick" AutomationProperties.AutomationId="shell.ctxFavoriteListRemove" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
