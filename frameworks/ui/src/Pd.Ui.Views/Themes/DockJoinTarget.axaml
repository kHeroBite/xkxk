<!-- UI-15 문서→패널 합류 드롭 안내 스타일: PanelJoinDrag 가 대상 ToolDockControl 에 .pdJoinTarget 을 붙이면 강조색 2px 테두리 + 반투명 덮개(어도너 층 — 내용 위, 입력 통과, 크기 불변) -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dock.Avalonia.Controls"
        xmlns:views="using:Pd.Ui.Views">
  <Styles.Resources>
    <!-- 창 탭 합류 원천 창 불투명도(MDI 테마 ^.pdTabJoinSource 의 0.55 와 같은 값 — MDI 테마가 이 키를 쓰도록 바꾸면 한 곳이 된다) -->
    <x:Double x:Key="PdTabJoinSourceOpacity">0.55</x:Double>
  </Styles.Resources>
  <Style Selector="controls|ToolDockControl.pdJoinTarget">
    <Setter Property="AdornerLayer.Adorner">
      <Template>
        <Panel IsHitTestVisible="False">
          <Border Background="{DynamicResource PdBrushAccent}" Opacity="0.16" />
          <Border BorderBrush="{DynamicResource PdBrushAccent}" BorderThickness="2" />
        </Panel>
      </Template>
    </Setter>
  </Style>
  <!-- 창 탭 합류(01 §4.4) SDI 표시 — SdiTitleBar.TabJoin.cs 가 클래스를 건다. MDI 쪽(MdiDocumentWindowTheme)과 같은 시각 언어:
       .pdTabJoinArmed = 로고를 숨기고 같은 중심에 합치기 아이콘(끄는 동안 다른 창, 2026-11-11 — 예전에는 로고 칸 바탕만 칠했다),
       .pdTabJoinTarget.pdTabJoinOnIcon = 합치기 아이콘 강조색, 탭 줄 .pdTabJoinTarget = 패널 합류와 같은 2px 테두리 + 반투명 덮개 -->
  <!-- ChromeLogo 는 StyleKeyOverride=Button 이라 형식 선택자(views|ChromeLogo)가 맞지 않는다 — 로고는 클래스(.pdLogo)로만 고른다.
       아이콘 기본 숨김은 여기서 정한다(SdiTitleBar.axaml 에 IsVisible 로컬 값을 두면 아래 armed Setter 를 이긴다) -->
  <Style Selector="views|SdiTitleBar Border.pdSdiTabJoinIcon">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="views|SdiTitleBar.pdTabJoinArmed .pdLogo Image.pdSdiLogoImage">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="views|SdiTitleBar.pdTabJoinArmed .pdLogo Border.pdSdiTabJoinIcon">
    <Setter Property="IsVisible" Value="True" />
    <!-- 바탕은 반투명 덮개(PdBrushMdiTitleButtonChecked)가 아니라 활성 제목줄 불투명색(2026-11-12 PC 비움 실측 dockjoin_live) — 끄는 동안 표적 창은 비활성이라 덮개가 비활성 제목줄(회색) 위에 합성돼 기호 대비가 2.27(pd-light)·2.6(pd-contrast)로 3:1 미만이었다. 기호·테두리는 활성 제목줄 위 기준이라 바탕도 활성 제목줄 색으로 맞춘다 -->
    <Setter Property="Background" Value="{DynamicResource PdChromeTitleActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PdChromeGlyph}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeGlyph}" />
  </Style>
  <Style Selector="views|SdiTitleBar.pdTabJoinTarget.pdTabJoinOnIcon .pdLogo Border.pdSdiTabJoinIcon">
    <Setter Property="Background" Value="{DynamicResource PdBrushAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PdChromeGlyphHover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PdBrushWhiteGlyph}" />
  </Style>
  <!-- 끄는 SDI 창(원천)은 표적 위에 있는 동안 반투명 — MDI(^.pdTabJoinSource, Opacity 0.55)와 같은 값. SdiTitleBar.TabJoin.cs 가 OS 창에도 .pdTabJoinSource 를 건다.
       :is(Window) 라 MDI 창(MdiDocumentWindow, Window 아님)에는 걸리지 않는다 -->
  <Style Selector=":is(Window).pdTabJoinSource">
    <Setter Property="Opacity" Value="{DynamicResource PdTabJoinSourceOpacity}" />
  </Style>
  <Style Selector="controls|DocumentTabStrip.pdTabJoinTarget">
    <Setter Property="AdornerLayer.Adorner">
      <Template>
        <Panel IsHitTestVisible="False">
          <Border Background="{DynamicResource PdBrushAccent}" Opacity="0.16" />
          <Border BorderBrush="{DynamicResource PdBrushAccent}" BorderThickness="2" />
        </Panel>
      </Template>
    </Setter>
  </Style>
</Styles>
