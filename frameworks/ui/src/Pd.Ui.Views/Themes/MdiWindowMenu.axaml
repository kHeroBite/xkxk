<!-- MDI 문서 창 우클릭 메뉴 재정의 — Dock 테마의 고정 영어 4항목(Cascade·Tile Horizontal·Tile Vertical·Restore)만 앱 사전(chrome.mdi.*)으로 바꾸고 나머지는 원본 그대로 둔다 -->
<!-- 원문: Dock.Avalonia.Themes.Fluent 12.1.0.12 Controls/MdiDocumentWindow.axaml 의 리소스 MdiDocumentWindowContextMenu (https://github.com/wieslawsoltes/Dock).
     MIT License, Copyright © Wiesław Šoltés. 패키지에 axaml 원문이 없어 컴파일된 XAML 디컴파일로 재구성했다(logs/odev3/ilspy_theme, logs/odev7c/mdimenu_src.txt).
     원문과 다른 점: 계단식·가로 바둑판·세로 바둑판·전체 복원 4항목의 Header 가 고정 영어 대신 {loc:Tr chrome.mdi.*} 다. 창 메뉴 공통 항목(WindowTitleMenu)이 맨 앞에 들어가고, 그 닫기와 겹치는 원문 '닫기' 항목은 뺐다. 나머지 항목 순서·명령·IsVisible 조건·DynamicResource 키는 원문과 같다.
     Dock 업그레이드 시 원문 메뉴 구성(항목 추가·조건 변경)을 다시 대조할 것.
     연결: MdiChrome.axaml 의 Styles.Resources MergedDictionaries 에서 ResourceInclude. App.axaml 에서 Dock 테마보다 뒤라 같은 키 재정의가 이긴다 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Dock.Avalonia.Converters"
                    xmlns:core="using:Dock.Model.Core"
                    xmlns:dmc="using:Dock.Model.Controls"
                    xmlns:loc="using:Pd.Poc.Shell.Localization"
                    xmlns:docking="using:Pd.Poc.Shell.Docking"
                    xmlns:views="using:Pd.Ui.Views">

  <ContextMenu x:Key="MdiDocumentWindowContextMenu" x:DataType="core:IDockable" views:WindowTitleMenu.Kind="Mdi">
    <MenuItem Header="{DynamicResource DocumentTabStripItemFloatString}"
              Command="{Binding Owner.Factory.FloatDockable}" CommandParameter="{Binding}">
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanFloatMultiConverter}">
            <Binding />
            <Binding Path="CanFloat" />
            <Binding Path="DockCapabilityOverrides?.CanFloat" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanFloat" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:CanRemoveDockableConverter.Instance}">
            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="True" />
            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
          </MultiBinding>
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <MenuItem Header="{DynamicResource DocumentTabStripItemFloatAllString}"
              Command="{Binding Owner.Factory.FloatAllDockables}" CommandParameter="{Binding}">
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanFloatMultiConverter}">
            <Binding />
            <Binding Path="CanFloat" />
            <Binding Path="DockCapabilityOverrides?.CanFloat" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanFloat" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:CanRemoveDockableConverter.Instance}">
            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="True" />
            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
          </MultiBinding>
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <Separator>
      <Separator.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanFloatMultiConverter}">
            <Binding />
            <Binding Path="CanFloat" />
            <Binding Path="DockCapabilityOverrides?.CanFloat" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanFloat" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:CanRemoveDockableConverter.Instance}">
            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="True" />
            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
          </MultiBinding>
        </MultiBinding>
      </Separator.IsVisible>
    </Separator>
    <MenuItem Header="{DynamicResource DocumentTabStripItemCloseOtherTabsString}"
              Command="{Binding Owner.Factory.CloseOtherDockables}" CommandParameter="{Binding}">
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanCloseMultiConverter}">
            <Binding />
            <Binding Path="CanClose" />
            <Binding Path="DockCapabilityOverrides?.CanClose" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanClose" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:CanRemoveDockableConverter.Instance}">
            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="True" />
            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
          </MultiBinding>
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <MenuItem Header="{DynamicResource DocumentTabStripItemCloseAllTabsString}"
              Command="{Binding Owner.Factory.CloseAllDockables}" CommandParameter="{Binding}">
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanCloseMultiConverter}">
            <Binding />
            <Binding Path="CanClose" />
            <Binding Path="DockCapabilityOverrides?.CanClose" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanClose" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:CanRemoveDockableConverter.Instance}">
            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="True" />
            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
          </MultiBinding>
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <Separator />
    <MenuItem Header="{DynamicResource DocumentTabStripItemNewHorizontalDockString}"
              Command="{Binding Owner.Factory.NewHorizontalDocumentDock}" CommandParameter="{Binding}">
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanDragMultiConverter}">
            <Binding />
            <Binding Path="CanDrag" />
            <Binding Path="DockCapabilityOverrides?.CanDrag" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanDrag" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanDropMultiConverter}">
            <Binding />
            <Binding Path="CanDrop" />
            <Binding Path="DockCapabilityOverrides?.CanDrop" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanDrop" Mode="OneWay" />
          </MultiBinding>
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <MenuItem Header="{DynamicResource DocumentTabStripItemNewVerticalDockString}"
              Command="{Binding Owner.Factory.NewVerticalDocumentDock}" CommandParameter="{Binding}">
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanDragMultiConverter}">
            <Binding />
            <Binding Path="CanDrag" />
            <Binding Path="DockCapabilityOverrides?.CanDrag" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanDrag" Mode="OneWay" />
          </MultiBinding>
          <MultiBinding Converter="{x:Static conv:DockCapabilityConverters.CanDropMultiConverter}">
            <Binding />
            <Binding Path="CanDrop" />
            <Binding Path="DockCapabilityOverrides?.CanDrop" Mode="OneWay" />
            <Binding Path="((core:IDock)Owner).DockCapabilityPolicy?.CanDrop" Mode="OneWay" />
          </MultiBinding>
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <!-- U14 분할 해제(앱 추가 항목): 분할 칸 문서를 모두 주 문서 영역 MDI 로 합치고 빈 칸을 정리한다. 분할이 있을 때만 보인다(SplitMergeService) -->
    <MenuItem Header="{loc:Tr chrome.mdi.unsplit}" Command="{x:Static docking:SplitMergeService.UnsplitCommand}" CommandParameter="{Binding}">
      <!-- 표시: Owner + 메뉴 열림(열 때마다 다시 계산 — 분할 생김/없어짐 반영, c2dev_n 실측 주 칸 메뉴 숨김 결함) -->
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static docking:SplitMergeService.UnsplitVisible}">
          <Binding Path="Owner" />
          <Binding Path="IsOpen" RelativeSource="{RelativeSource AncestorType=ContextMenu}" FallbackValue="False" />
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
    <Separator />
    <!-- 원문 고정 영어 4항목 → 앱 사전. 문구는 '창' 메뉴(menu.window.cascade·tileH·tileV·restoreAll)와 같은 용어 -->
    <MenuItem Header="{loc:Tr chrome.mdi.cascade}" Command="{Binding ((dmc:IDocumentDock)Owner).CascadeDocuments}" />
    <MenuItem Header="{loc:Tr chrome.mdi.tileH}" Command="{Binding ((dmc:IDocumentDock)Owner).TileDocumentsHorizontal}" />
    <MenuItem Header="{loc:Tr chrome.mdi.tileV}" Command="{Binding ((dmc:IDocumentDock)Owner).TileDocumentsVertical}" />
    <MenuItem Header="{loc:Tr chrome.mdi.restore}" Command="{Binding ((dmc:IDocumentDock)Owner).RestoreDocuments}" />
    <Separator />
    <MenuItem Header="{DynamicResource DocumentTabStripItemLayoutModeString}">
      <MenuItem Header="{DynamicResource DocumentTabStripItemLayoutModeTabbedString}"
                Command="{Binding Owner.Factory.SetDocumentDockLayoutModeTabbed}" CommandParameter="{Binding Owner}" />
      <MenuItem Header="{DynamicResource DocumentTabStripItemLayoutModeMdiString}"
                Command="{Binding Owner.Factory.SetDocumentDockLayoutModeMdi}" CommandParameter="{Binding Owner}" />
    </MenuItem>
  </ContextMenu>

  <!-- U14 탭 문서 모드: Dock 기본 탭 우클릭 메뉴(DocumentTabStripItemContextMenu)는 재정의하지 않고 이 항목만 덧붙인다(DocumentTabMenu.InstallUnsplit) -->
  <Template x:Key="PdUnsplitTabMenuItem">
    <MenuItem x:DataType="core:IDockable" Name="PdUnsplit" Header="{loc:Tr chrome.mdi.unsplit}"
              Command="{x:Static docking:SplitMergeService.UnsplitCommand}" CommandParameter="{Binding}">
      <!-- 표시: Owner + 메뉴 열림(열 때마다 다시 계산 — 분할 생김/없어짐 반영, c2dev_n 실측 주 칸 메뉴 숨김 결함) -->
      <MenuItem.IsVisible>
        <MultiBinding Converter="{x:Static docking:SplitMergeService.UnsplitVisible}">
          <Binding Path="Owner" />
          <Binding Path="IsOpen" RelativeSource="{RelativeSource AncestorType=ContextMenu}" FallbackValue="False" />
        </MultiBinding>
      </MenuItem.IsVisible>
    </MenuItem>
  </Template>
</ResourceDictionary>
