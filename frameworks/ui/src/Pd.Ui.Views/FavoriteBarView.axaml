<!-- 제목줄 즐겨찾기 영역(REQ-113, 09/22 §4) — 오른쪽부터 채우는 화면 아이콘 줄, 자리가 모자라면 왼쪽 끝 » 팝업. 클릭=활성화 또는 열기, 우클릭=빼기, 끌어서 순서 바꾸기(코드 비하인드). 데이터·명령은 FavoriteBarViewModel -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pd.Poc.Shell.ViewModels"
             xmlns:views="using:Pd.Ui.Views"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             x:Class="Pd.Ui.Views.FavoriteBarView"
             x:DataType="vm:FavoriteBarViewModel"
             AutomationProperties.AutomationId="shell.favoriteBar">
  <UserControl.Styles>
    <Style Selector="Button.favIcon">
      <Setter Property="Width" Value="{x:Static views:FavoriteBarView.ItemWidth}" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.favIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.favIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PdChromeTabHoverBackground}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <!-- 넘침 » : 보이지 않는 즐겨찾기 목록(영역 왼쪽 끝 — 오른쪽부터 채우므로 넘친 항목은 왼쪽 바깥이다) -->
    <Button x:Name="OverflowButton" Classes="favIcon" IsVisible="{Binding HasOverflow}" Content="»"
            AutomationProperties.AutomationId="shell.favoriteOverflow" AutomationProperties.Name="{loc:Tr favorite.more}" ToolTip.Tip="{loc:Tr favorite.more}">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <ItemsControl ItemsSource="{Binding OverflowItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FavoriteItem">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,3"
                        AutomationProperties.AutomationId="{Binding AutomationId}" Click="OnOverflowItemClick">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <views:WindowIcon IconKey="{Binding IconKey}" FallbackText="{Binding Title}" Width="16" Height="16" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- 보이는 즐겨찾기: 오른쪽부터(첫 항목이 오른쪽 끝). 줄만 RightToLeft 로 놓고 항목 안은 LeftToRight 로 되돌려 아이콘·글자가 뒤집히지 않게 한다 -->
    <ItemsControl x:Name="FavoriteItems" ItemsSource="{Binding VisibleItems}" FlowDirection="RightToLeft">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="{x:Static views:FavoriteBarView.ItemSpacing}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FavoriteItem">
          <Button Classes="favIcon" FlowDirection="LeftToRight"
                  AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Title}"
                  Click="OnItemClick">
            <views:WindowIcon IconKey="{Binding IconKey}" FallbackText="{Binding Title}" Width="16" Height="16" />
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{loc:Tr favorite.remove}" AutomationProperties.AutomationId="shell.ctxFavoriteRemove" Click="OnRemoveClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
