<!-- 요소별 디자인 편집 패널(REQ-101, 17 문서 §6~§9) — 요소 목록 | 속성 행(값 편집기·덮어씀·잠금·대비 경고·되돌리기), 요소·전체 되돌리기(전체는 패널 안 확인), 미리보기 표본.
     넓은 폭 2열, 좁은 폭(태블릿형 좁은 창·모바일형) 1열 — 1열은 요소 목록 → 속성 화면 이동(코드비하인드가 칸 배치만 바꾼다). 문구는 Loc 키만, 색·크기는 토큰만 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pd.Poc.Shell.ViewModels"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             x:Class="Pd.Ui.Views.ThemeDesignPanel"
             x:DataType="vm:ThemeDesignViewModel"
             AutomationProperties.AutomationId="themeDesign.panel">

  <UserControl.Resources>
    <!-- 모바일형 터치 대상 최소(17 §8) -->
    <x:Double x:Key="DesignTouchTarget">44</x:Double>
    <!-- 회사 잠금 자물쇠 모양(16 단위 상자) -->
    <StreamGeometry x:Key="DesignLockGeometry">M4,7 L4,5 C4,2.8 5.8,1 8,1 C10.2,1 12,2.8 12,5 L12,7 L13,7 L13,15 L3,15 L3,7 Z M6,7 L10,7 L10,5 C10,3.9 9.1,3 8,3 C6.9,3 6,3.9 6,5 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource PdFontCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource PdBrushTextMuted}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource PdFontSubtitle}" />
      <Setter Property="FontWeight" Value="{DynamicResource PdFontWeightStrong}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource PdBrushWarning}" />
    </Style>
    <Style Selector="TextBox.invalid, AutoCompleteBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource PdBrushError}" />
    </Style>
    <!-- 1열(좁은 폭): 터치 대상 44 이상 -->
    <Style Selector="UserControl.narrow ListBoxItem, UserControl.narrow Button, UserControl.narrow TextBox, UserControl.narrow ComboBox, UserControl.narrow NumericUpDown, UserControl.narrow AutoCompleteBox">
      <Setter Property="MinHeight" Value="{StaticResource DesignTouchTarget}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="PanelGrid" ColumnDefinitions="180,12,*">
    <!-- 왼쪽: 요소 목록(덮어쓴 요소는 점) -->
    <DockPanel x:Name="ElementPane" Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="{loc:Tr theme.design.title}" Classes="section" Margin="0,0,0,6" />
      <TextBlock DockPanel.Dock="Top" Text="{loc:Tr theme.design.builtinHint}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,6" />
      <ListBox x:Name="ElementList" AutomationProperties.AutomationId="themeDesign.lstElements"
               AutomationProperties.Name="{loc:Tr theme.design.title}"
               ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
               BorderBrush="{DynamicResource PdBrushBorder}" BorderThickness="1">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ThemeDesignElement">
            <Grid ColumnDefinitions="*,Auto" AutomationProperties.AutomationId="{Binding Key, StringFormat='themeDesign.el.{0}'}">
              <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Ellipse Grid.Column="1" Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource PdBrushAccent}"
                       IsVisible="{Binding IsOverridden}" ToolTip.Tip="{loc:Tr theme.design.overridden.tooltip}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- 오른쪽: 선택 요소의 속성 -->
    <!-- 보임 여부는 코드비하인드(UpdatePanes)가 HasSelection·폭으로 정한다 -->
    <DockPanel x:Name="DetailPane" Grid.Column="2">
      <!-- 머리: (1열) 목록으로 · 요소 이름 · 대비 -->
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
        <Button x:Name="BackButton" AutomationProperties.AutomationId="themeDesign.btnBack" AutomationProperties.Name="{loc:Tr theme.design.title}"
                Command="{Binding BackCommand}" IsVisible="False" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="‹" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr theme.design.title}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock AutomationProperties.AutomationId="themeDesign.lblElement" Text="{Binding ElementLabel}" Classes="section" />
        <TextBlock AutomationProperties.AutomationId="themeDesign.lblContrast" Text="{Binding ContrastText}" Classes="caption" Classes.warn="{Binding ContrastWarn}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 바닥: 되돌리기·전체 되돌리기 확인·상태·미리보기 표본 -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
        <WrapPanel>
          <Button AutomationProperties.AutomationId="themeDesign.btnResetElement" Content="{loc:Tr theme.design.reset.element}"
                  Command="{Binding ResetElementCommand}" IsEnabled="{Binding IsElementOverridden}" Margin="0,0,6,6" />
          <Button AutomationProperties.AutomationId="themeDesign.btnResetAll" Content="{loc:Tr theme.design.reset.all}"
                  Command="{Binding ResetAllCommand}" IsVisible="{Binding !IsConfirmingResetAll}" Margin="0,0,6,6" />
        </WrapPanel>
        <!-- 전체 되돌리기 확인(17 §6 — 대화상자 대신 패널 안 확인 영역) -->
        <Border AutomationProperties.AutomationId="themeDesign.confirmResetAll" IsVisible="{Binding IsConfirmingResetAll}" Padding="8"
                BorderBrush="{DynamicResource PdBrushWarning}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource PdBrushSurfaceAlt}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ResetAllConfirmText}" TextWrapping="Wrap" />
            <WrapPanel>
              <Button AutomationProperties.AutomationId="themeDesign.btnConfirmResetAll" Content="{loc:Tr theme.design.reset.confirmYes}"
                      Command="{Binding ConfirmResetAllCommand}" Margin="0,0,6,0" />
              <Button AutomationProperties.AutomationId="themeDesign.btnCancelResetAll" Content="{loc:Tr theme.design.reset.confirmNo}"
                      Command="{Binding CancelResetAllCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock AutomationProperties.AutomationId="themeDesign.lblStatus" Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
        <!-- 미리보기 표본(보조 — 실제 반영은 셸 요소에서 확인, 17 §7). 앱 수준 요소 스타일을 그대로 받는다 -->
        <Border AutomationProperties.AutomationId="themeDesign.preview" Padding="8" BorderBrush="{DynamicResource PdBrushBorder}" BorderThickness="1"
                CornerRadius="4" Background="{DynamicResource PdBrushSurface}" IsHitTestVisible="False" Focusable="False">
          <StackPanel Spacing="6">
            <WrapPanel>
              <Button Content="{loc:Tr theme.design.button}" Margin="0,0,6,0" Focusable="False" />
              <TextBox PlaceholderText="{loc:Tr theme.design.input}" MinWidth="120" Focusable="False" />
            </WrapPanel>
            <!-- 표 머리 표본: 글자·여백은 로컬 값 없이 클래스 pdPreviewGridHeader 로 gridHeader 요소 지정 값을 받는다(미지정이면 상속 = 지금 화면) -->
            <Border Background="{DynamicResource PdBrushGridHeader}" BorderBrush="{DynamicResource PdBrushGridHeaderLine}" BorderThickness="0,0,0,1">
              <ContentControl Classes="pdPreviewGridHeader" Focusable="False">
                <TextBlock Text="{loc:Tr theme.design.gridHeader}" Foreground="{DynamicResource PdBrushText}" />
              </ContentControl>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 속성 행 -->
      <ScrollViewer x:Name="RowScroll" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl AutomationProperties.AutomationId="themeDesign.lstRows" ItemsSource="{Binding Rows}" IsEnabled="{Binding IsEditable}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThemeDesignRow">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3" AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.row.{0}'}"
                    AutomationProperties.HelpText="{Binding StateText}">
                <!-- 이름·실효값 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource PdBrushAccent}" IsVisible="{Binding IsOverridden}"
                             ToolTip.Tip="{loc:Tr theme.design.overridden.tooltip}" />
                    <Path Data="{StaticResource DesignLockGeometry}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{DynamicResource PdBrushTextMuted}" IsVisible="{Binding IsLocked}" ToolTip.Tip="{loc:Tr theme.design.locked.tooltip}" />
                    <TextBlock Text="⚠" Classes="warn" VerticalAlignment="Center" IsVisible="{Binding ShowsContrastWarn}"
                               ToolTip.Tip="{loc:Tr theme.design.state.contrastWarn}" />
                  </StackPanel>
                  <TextBlock Text="{Binding EffectiveValue}" Classes="caption" TextTrimming="CharacterEllipsis"
                             AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.effective.{0}'}" />
                </StackPanel>

                <!-- 값 편집기(행 종류마다 하나만 보인다) -->
                <Panel Grid.Column="1" Width="200" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}">
                  <!-- 색: 선택기 + hex -->
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsColorEditor}">
                    <ColorPicker Grid.Column="0" Color="{Binding Color, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.pick.{0}'}"
                                 AutomationProperties.Name="{Binding Label}" />
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Classes.invalid="{Binding !IsValid}" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.value.{0}'}"
                             AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding StateText}" />
                  </Grid>
                  <!-- 글꼴: 후보 목록 + 직접 입력 -->
                  <AutoCompleteBox IsVisible="{Binding IsFontEditor}" ItemsSource="{Binding FontOptions}" Text="{Binding Value, Mode=TwoWay}"
                                   FilterMode="Contains" MinimumPrefixLength="0" Classes.invalid="{Binding !IsValid}" PlaceholderText="{loc:Tr theme.design.inherit}"
                                   AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.value.{0}'}"
                                   AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding StateText}" />
                  <!-- 굵기 -->
                  <ComboBox IsVisible="{Binding IsWeightEditor}" ItemsSource="{Binding WeightOptions}" SelectedItem="{Binding SelectedWeight, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" PlaceholderText="{loc:Tr theme.design.inherit}"
                            AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.value.{0}'}"
                            AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding StateText}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LocalizedOption"><TextBlock Text="{Binding Text}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <!-- 숫자(글자 크기 오프셋·모서리·테두리): 범위는 VM(ThemeElements 표) 값, 비우면 되돌리기 -->
                  <NumericUpDown IsVisible="{Binding IsNumberEditor}" Value="{Binding Number, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                 Increment="{Binding Increment}" FormatString="0" HorizontalAlignment="Stretch" PlaceholderText="{loc:Tr theme.design.inherit}"
                                 AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.value.{0}'}"
                                 AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding StateText}" />
                  <!-- 여백: "n" · "좌우,상하" · "좌,위,우,아래" -->
                  <TextBox IsVisible="{Binding IsTextEditor}" Text="{Binding Value, Mode=TwoWay}" Classes.invalid="{Binding !IsValid}" PlaceholderText="{loc:Tr theme.design.inherit}"
                           AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.value.{0}'}"
                           AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding StateText}" />
                </Panel>

                <!-- 속성 되돌리기 -->
                <Button Grid.Column="2" Content="{loc:Tr theme.design.reset.prop}" Command="{Binding ResetCommand}" Margin="6,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat='themeDesign.reset.{0}'}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
