<!-- 한글 입력(IME) 확인용 입력 폼 문서 화면(제목 + 한 줄 입력 5개 + 여러 줄 입력 + 저장). 글자는 셸 토큰(PdFont*), 문구는 다국어 사전(doc.form.*)을 따른다 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             x:Class="Pd.Ui.Views.Documents.FormDocumentView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <!-- 라벨 열은 Auto: 글자 크기·언어가 바뀌어도 라벨이 잘리지 않는다. Stretch+MaxWidth: 창이 좁으면 창 폭, 넓으면 720 까지(좁은 창에서 입력칸 잘림 방지) -->
    <Grid Margin="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:Tr doc.form.title}" FontSize="{DynamicResource PdFontTitle}" FontWeight="{DynamicResource PdFontWeightStrong}" Margin="0,0,0,4" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:Tr doc.form.intro}" TextWrapping="Wrap" FontSize="{DynamicResource PdFontDetail}" Foreground="{DynamicResource PdBrushTextMuted}" Margin="0,0,0,8" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr doc.form.taskName}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox x:Name="TitleBox" AutomationProperties.AutomationId="form.txtTitle" Grid.Row="2" Grid.Column="1" Margin="0,3" PlaceholderText="{loc:Tr doc.form.taskName.placeholder}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr doc.form.owner}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox x:Name="OwnerBox" AutomationProperties.AutomationId="form.txtOwner" Grid.Row="3" Grid.Column="1" Margin="0,3" PlaceholderText="{loc:Tr doc.form.owner.placeholder}" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr doc.form.client}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox x:Name="ClientBox" AutomationProperties.AutomationId="form.txtClient" Grid.Row="4" Grid.Column="1" Margin="0,3" PlaceholderText="{loc:Tr doc.form.client.placeholder}" />
      <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr doc.form.place}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox x:Name="PlaceBox" AutomationProperties.AutomationId="form.txtPlace" Grid.Row="5" Grid.Column="1" Margin="0,3" PlaceholderText="{loc:Tr doc.form.place.placeholder}" />
      <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Tr doc.form.category}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <TextBox x:Name="CategoryBox" AutomationProperties.AutomationId="form.txtCategory" Grid.Row="6" Grid.Column="1" Margin="0,3" PlaceholderText="{loc:Tr doc.form.category.placeholder}" />
      <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Tr doc.form.body}" VerticalAlignment="Top" Margin="0,8,12,0" />
      <StackPanel Grid.Row="7" Grid.Column="1">
        <TextBox x:Name="BodyBox" AutomationProperties.AutomationId="form.txtBody" Margin="0,3" MinHeight="140"
                 AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{loc:Tr doc.form.body.placeholder}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6">
          <Button x:Name="SaveButton" AutomationProperties.AutomationId="form.btnSave" Content="{loc:Tr common.save}" />
          <Button x:Name="ClearButton" AutomationProperties.AutomationId="form.btnClear" Content="{loc:Tr doc.form.clear}" />
        </StackPanel>
        <TextBlock x:Name="SavedText" AutomationProperties.AutomationId="form.lblSaved" TextWrapping="Wrap" Foreground="{DynamicResource PdBrushTextMuted}" FontSize="{DynamicResource PdFontCaption}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
