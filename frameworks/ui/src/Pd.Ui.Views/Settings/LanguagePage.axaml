<!-- 설정 창 '언어' 페이지(요건 7) — 표시 언어. 값은 LanguagePageViewModel, 이 파일에 로직 없음 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:Pd.Poc.Shell.ViewModels.Settings"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             xmlns:ui="using:Pd.Ui.Controls"
             x:Class="Pd.Ui.Views.Settings.LanguagePage"
             x:DataType="vms:LanguagePageViewModel">
  <StackPanel>
    <ui:SettingsRow SettingId="language" Label="{loc:Tr lang.label}">
      <ComboBox ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" MinWidth="200"
                AutomationProperties.AutomationId="shell.cmbLanguage" />
    </ui:SettingsRow>
  </StackPanel>
</UserControl>
