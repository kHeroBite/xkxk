<!-- 알림 패널 화면(UI-15) — 샘플 알림 목록. 건수는 패널 제목, 위치는 제목 줄 우클릭 메뉴(PanelPositionMenu)가 맡는다 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pd.Poc.Shell.ViewModels"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             xmlns:input="using:Pd.Ui.Input"
             x:Class="Pd.Ui.Views.NotificationPanelView"
             x:DataType="vm:NotificationPanelViewModel"
             AutomationProperties.AutomationId="notify.root">
  <DockPanel Background="{DynamicResource PdBrushSurface}">
    <!-- Dock 패널에서는 머리줄 제목이 '알림(5건)'이라 이 줄을 숨긴다. 패널 제목 줄이 없는 곳(폰 알림 화면)에서만 같은 제목을 보인다 -->
    <Border x:Name="HostlessHeader" DockPanel.Dock="Top" Padding="8,4" AutomationProperties.AutomationId="notify.title" Background="{DynamicResource PdBrushSurfaceAlt}"
            BorderBrush="{DynamicResource PdBrushBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 AutomationProperties.AutomationId="notify.count"
                 Foreground="{DynamicResource PdBrushTextMuted}" FontSize="{DynamicResource PdFontDetail}" />
    </Border>
    <ListBox ItemsSource="{Binding Items}" Background="Transparent"
             AutomationProperties.AutomationId="notify.list" input:DenseList.Enable="True">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:NotificationItem">
          <StackPanel Spacing="2" Margin="0,2">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                         Foreground="{DynamicResource PdBrushTextMuted}" FontSize="{DynamicResource PdFontCaption}" />
              <TextBlock Text="{Binding Category}" Foreground="{DynamicResource PdBrushAccent}"
                         FontSize="{DynamicResource PdFontCaption}" />
            </DockPanel>
            <!-- 긴 제목(영어 등)은 2줄까지 감싸고 넘치면 말줄임표, 전체 문구는 툴팁. 한 줄에 들어가는 한국어 제목은 배치가 그대로다 -->
            <TextBlock Text="{Binding Title}" FontWeight="{DynamicResource PdFontWeightStrong}" Foreground="{DynamicResource PdBrushText}"
                       FontSize="{DynamicResource PdFontBody}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Title}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource PdBrushText}"
                       FontSize="{DynamicResource PdFontDetail}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
