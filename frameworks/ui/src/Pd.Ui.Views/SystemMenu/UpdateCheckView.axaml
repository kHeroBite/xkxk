<!-- 업데이트 확인 화면(UI-17) — 현재 버전·채널·빌드 시각, [다시 확인] 결과(서버 전에는 '업데이트 서버 미구축'), 플랫폼별 업데이트 방식 안내. 문자열은 다국어 사전 키 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pd.Poc.Shell.ViewModels.SystemMenu"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             x:Class="Pd.Ui.Views.SystemMenu.UpdateCheckView"
             x:DataType="vm:AboutViewModel">
  <StackPanel Margin="14" Spacing="8">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
      <TextBlock Grid.Row="0" Text="{loc:Tr sysview.about.version}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" AutomationProperties.AutomationId="sys.update.version" />
      <TextBlock Grid.Row="1" Text="{loc:Tr sysview.about.channel}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Channel}" AutomationProperties.AutomationId="sys.update.channel" />
      <TextBlock Grid.Row="2" Text="{loc:Tr sysview.about.buildTime}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildTime}" />
    </Grid>
    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontWeight="{DynamicResource PdFontWeightStrong}"
               AutomationProperties.AutomationId="sys.update.lblStatus" />
    <TextBlock Text="{Binding UpdateHowTo}" TextWrapping="Wrap" Opacity="0.8" />
    <Button Content="{loc:Tr sysview.update.checkAgain}" Command="{Binding CheckUpdateCommand}" HorizontalAlignment="Right"
            AutomationProperties.AutomationId="sys.update.btnCheck" />
  </StackPanel>
</UserControl>
