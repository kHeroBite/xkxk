<!-- 변경이력 화면(UI-17) — 앱에 내장한 변경이력(ko/en). 서버 제공 변경이력은 pd-server 구축 뒤. 문자열은 다국어 사전 키 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             x:Class="Pd.Ui.Views.SystemMenu.ChangelogView">
  <ScrollViewer AutomationProperties.AutomationId="sys.changelog.scroll">
    <StackPanel Margin="14" Spacing="4">
      <TextBlock Text="{loc:Tr sysview.changelog.note}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,6" />
      <TextBlock Text="{loc:Tr sysview.changelog.r3.title}" FontWeight="{DynamicResource PdFontWeightStrong}" />
      <TextBlock Text="{loc:Tr sysview.changelog.r3.body}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock Text="{loc:Tr sysview.changelog.r2.title}" FontWeight="{DynamicResource PdFontWeightStrong}" />
      <TextBlock Text="{loc:Tr sysview.changelog.r2.body}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock Text="{loc:Tr sysview.changelog.r1.title}" FontWeight="{DynamicResource PdFontWeightStrong}" />
      <TextBlock Text="{loc:Tr sysview.changelog.r1.body}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
