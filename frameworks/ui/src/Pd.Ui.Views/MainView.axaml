<!-- 셸 메인 화면 — 통합 제목줄(로고·제목·메뉴·캡션 버튼)·제목 줄(제목 탭·독립 창 아이콘)·도구모음·레이아웃·이름 변경 패널·Dock 영역·상태바. 문자열은 다국어 사전 키 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:docking="using:Pd.Poc.Shell.Docking"
             xmlns:vm="using:Pd.Poc.Shell.ViewModels"
             xmlns:views="using:Pd.Ui.Views"
             xmlns:loc="using:Pd.Poc.Shell.Localization"
             xmlns:input="using:Pd.Ui.Views.Input"
             xmlns:ui="using:Pd.Ui.Controls"
             x:Class="Pd.Ui.Views.MainView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- 제목 탭 폭 토큰(공통원칙 §2-1) -->
    <x:Double x:Key="PdTitleTabMinWidth">72</x:Double>
    <x:Double x:Key="PdTitleTabMaxWidth">240</x:Double>
    <!-- 제목 줄·제목 탭 높이(PdTitleStripHeight·PdTitleTabHeight)는 앱 리소스(PdApp.axaml 기본 38·32)이고 설정 '탭 줄 높이'가 바꾼다(공통원칙 §2-1, 2026-11-11) -->
  </UserControl.Resources>

  <DockPanel>
    <!-- Q14 통합 제목줄: [로고][제목][메뉴][끌기 빈칸][최소화][최대화][닫기]. U21 Tab 키 포커스는 이 영역 안에서만 순환한다(Input/TabFocusScope) -->
    <views:MainTitleBar DockPanel.Dock="Top" IsVisible="{Binding Compact.ShowsDesktopChrome}" KeyboardNavigation.TabNavigation="Cycle" input:TabFocusScope.IsScope="True" />

    <!-- 제목 줄(공통원칙 §2-1, 22 §4): [제목 탭 →][빈칸][독립 창 아이콘][구분선][즐겨찾기 ←]. 즐겨찾기 자리 before_sdi 면 열 순서를 코드비하인드(MainView.FavoriteBar.cs)가 바꾼다.
         표시 조건은 TitleStrip 이 계산한다(DOCK 은 제목 탭 숨김, 폰 NAV 는 줄 없음) -->
    <Grid x:Name="TitleStripGrid" DockPanel.Dock="Top" Height="{DynamicResource PdTitleStripHeight}" ColumnDefinitions="*,Auto,Auto,Auto"
          AutomationProperties.AutomationId="shell.titleStrip"
          Background="{DynamicResource PdBrushToolBar}"
          IsVisible="{Binding TitleStrip.ShowTitleStrip}">
    <!-- 제목 탭(MDI-03): 활성 하이라이트(선택)·좌클릭=활성이면 최소화/아니면 활성화·× 닫기·우클릭 창 메뉴(우클릭은 활성화하지 않고 대상만 정한다 — 코드비하인드) -->
    <ListBox x:Name="TaskbarTabs"
             Grid.Column="0"
             AutomationProperties.AutomationId="shell.tabStrip"
             IsVisible="{Binding TitleStrip.ShowTitleTabs}"
             ItemsSource="{Binding TitleStrip.TitleTabs}"
             SelectedItem="{Binding TitleStrip.SelectedTitleTab, Mode=TwoWay}"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             Background="Transparent"
             BorderThickness="0"
             Padding="0">
      <ListBox.Styles>
        <!-- 제목 탭 높이(PdTitleTabHeight): 항목 기본 여백을 없애 줄 안에 세로 가운데로 둔다 -->
        <Style Selector="ListBoxItem" x:DataType="docking:PocDocument">
          <Setter Property="Height" Value="{DynamicResource PdTitleTabHeight}" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
          <!-- 원격·자동화가 탭 항목(hover 대상)을 찾는 id(ui.pseudo id=shell.tabItem.{Id} cls=:pointerover) -->
          <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat='shell.tabItem.{0}'}" />
        </Style>
        <!-- U7 탭 3상태(토큰 odev-chrome ChromeResources·CaptionLayout): 비활성 → hover → 활성(창 제목줄과 같은 반전) → 최소화(흐린 글자, 선택 중이어도 이긴다) 순서로 둔다 — 같은 속성은 뒤 스타일이 이긴다.
             탭 글자·× 는 항목 안 Button 이 그리며 Fluent Button 테마가 자기 Foreground 를 지정해 상속되지 않으므로 Button 에도 직접 준다 -->
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdChromeTabInactiveBackground}" /></Style>
        <Style Selector="ListBoxItem Button, ListBoxItem Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeTabInactiveText}" /></Style>
        <!-- U5 hover: 탭 안 버튼(제목·×)은 바탕을 칠하지 않고 탭 전체(항목) 바탕만 바뀐다 — 글자 부분만 회색이 되던 문제(3.png). 활성 탭은 hover 바탕 없음 -->
        <Style Selector="ListBoxItem Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdChromeTabHoverBackground}" /></Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource PdChromeTabActiveBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource PdChromeTabActiveText}" />
        </Style>
        <Style Selector="ListBoxItem:selected Button, ListBoxItem:selected Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeTabActiveText}" /></Style>
        <Style Selector="ListBoxItem.minimized:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdChromeTabMinimizedBackground}" /></Style>
        <Style Selector="ListBoxItem.minimized Button, ListBoxItem.minimized Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeTabMinimizedText}" /></Style>
        <!-- 제목 탭 닫기(×) 표시 방식(01 §2-1, 설정 TitleTabCloseMode — 목록 클래스는 코드비하인드가 단다: 없음=항상, closeHover=올렸을 때, closeActive=활성 탭 항상).
             × 는 제목 끝 위에 겹쳐 그리고(글자 밀림 없음) 보일 때만 그 부분 제목을 흐린다(MainView.TitleFade). 숨김은 Opacity 0 이라 Tab 포커스는 그대로 받는다.
             같은 속성은 뒤 스타일이 이기므로 기본(보임) → 숨김 → 다시 보임(hover·키보드 포커스·활성) 순서로 둔다 -->
        <Style Selector="ListBoxItem Button.tabTitle"><Setter Property="views:MainView.TitleFade" Value="True" /></Style>
        <Style Selector="ListBox.closeHover ListBoxItem Button.tabClose, ListBox.closeActive ListBoxItem Button.tabClose"><Setter Property="Opacity" Value="0" /></Style>
        <Style Selector="ListBox.closeHover ListBoxItem Button.tabTitle, ListBox.closeActive ListBoxItem Button.tabTitle"><Setter Property="views:MainView.TitleFade" Value="False" /></Style>
        <Style Selector="ListBoxItem:pointerover Button.tabClose, ListBoxItem.kbfocus Button.tabClose, ListBoxItem:focus-visible Button.tabClose, ListBoxItem Button.tabClose:focus-visible, ListBox.closeActive ListBoxItem:selected Button.tabClose">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.tabTitle, ListBoxItem.kbfocus Button.tabTitle, ListBoxItem:focus-visible Button.tabTitle, ListBox.closeActive ListBoxItem:selected Button.tabTitle">
          <Setter Property="views:MainView.TitleFade" Value="True" />
        </Style>
        <!-- U4 제목 탭 가로 스크롤(최소 폭에서도 넘칠 때만): 얇은 선 하나(Themes/ThinScrollBar.axaml) -->
        <Style Selector="ScrollBar"><Setter Property="Theme" Value="{StaticResource PdThinScrollBar}" /></Style>
        <!-- 제목 탭 표시 방식(22 §3 — 목록 클래스는 코드비하인드 MainView.FavoriteBar.cs 가 단다: 없음=아이콘+제목, tabsIcon=아이콘만, tabsTitle=제목만) -->
        <!-- 방식마다 바뀌는 값은 요소에 직접 쓰지 않는다(요소에 쓴 값은 스타일을 이긴다) -->
        <Style Selector="views|WindowIcon.tabIcon"><Setter Property="Margin" Value="0,0,5,0" /></Style>
        <Style Selector="Button.tabTitle"><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
        <Style Selector="ListBox.tabsIcon TextBlock.tabText"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="ListBox.tabsIcon views|WindowIcon.tabIcon"><Setter Property="Margin" Value="0" /></Style>
        <Style Selector="ListBox.tabsIcon Button.tabTitle"><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
        <Style Selector="ListBox.tabsTitle views|WindowIcon.tabIcon"><Setter Property="IsVisible" Value="False" /></Style>
        <!-- 제목만일 때 불러오는 중 대체 표시(23 §4 busy_icon.title_only): inline=제목 앞 스피너(같은 WindowIcon 을 그동안만), underline=탭 아래 진행 줄(움직임 없음), none=없음 -->
        <!-- busyShown 은 WindowIcon.IsBusyShown(표시 지연·최소 표시 판정, 23 §3)을 클래스로 옮긴 것 -->
        <Style Selector="ListBox.tabsTitle.busyInline views|WindowIcon.tabIcon.busyShown"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="Border.tabBusyLine"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="ListBox.tabsTitle.busyUnderline Border.tabBusyLine.busyShown"><Setter Property="IsVisible" Value="True" /></Style>
        <!-- 주의 환기(MDI-05) 깜빡임 -->
        <Style Selector="Grid.attention">
          <Setter Property="Background" Value="{DynamicResource PdBrushAttention}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <ui:TitleTabPanel Spacing="2" MinTabWidth="{DynamicResource PdTitleTabMinWidth}" MaxTabWidth="{DynamicResource PdTitleTabMaxWidth}" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="docking:PocDocument">
          <!-- 단일 칸: 제목이 탭 전체 폭을 쓰고 × 는 오른쪽 끝(RTL 은 왼쪽 끝)에 겹친다. × 를 숨기면 그 자리도 제목이 쓴다(01 §2-1, 2026-11-12) -->
          <Grid Classes.attention="{Binding IsAttention}">
            <ToolTip.Tip>
              <MultiBinding Converter="{x:Static views:MainView.TabToolTipConverter}">
                <Binding Path="Title" />
                <Binding Path="Project" />
              </MultiBinding>
            </ToolTip.Tip>
            <Button Classes="tabTitle" Padding="6,0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat='shell.tab.{0}'}"
                    AutomationProperties.Name="{Binding Title}"
                    Command="{ReflectionBinding $parent[ListBox].DataContext.TabClickCommand}"
                    CommandParameter="{Binding}">
              <!-- 표시 방식(ui.shell.title_tab.display, 22 §3): 기본 아이콘+제목, icon 은 아이콘만(제목은 툴팁), title 은 제목만(불러오는 중 대체 표시는 위 스타일) -->
              <Grid ColumnDefinitions="Auto,*">
                <views:WindowIcon x:Name="TabIcon" Classes="tabIcon" Classes.busyShown="{Binding $self.IsBusyShown}" Grid.Column="0" Document="{Binding}" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Classes="tabText" Grid.Column="1" Text="{Binding Title}" AutomationProperties.AutomationId="{Binding Id, StringFormat='shell.tabTitle.{0}'}" FontSize="{DynamicResource PdFontCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><!-- 시스템 글자 캡션(기본 12, 01 §2-1·§5.2) -->
              </Grid>
            </Button>
            <Button Classes="tabClose" Padding="4,0" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat='shell.tabClose.{0}'}" AutomationProperties.Name="{loc:Tr menu.window.close}"
                    ToolTip.Tip="{loc:Tr menu.window.close}"
                    Command="{ReflectionBinding $parent[ListBox].DataContext.CloseCommand}"
                    CommandParameter="{Binding}"><PathIcon Width="8" Height="8" Data="{StaticResource PdGlyphClose}" /></Button>
            <Border Classes="tabBusyLine" Classes.busyShown="{Binding #TabIcon.IsBusyShown}" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{DynamicResource PdBrushAccent}"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat='shell.tabBusyLine.{0}'}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ContextMenu>
        <!-- 창 항목(이전 크기로·최소화·최대화·기본 위치로 이동·닫기)은 공통 컴포넌트(WindowTitleMenu). 이 아래 항목의 대상 문서도 컴포넌트가 우클릭한 탭으로 맞춘다 -->
        <ContextMenu views:WindowTitleMenu.Kind="Tab">
          <MenuItem Header="{loc:Tr menu.window.closeOthers}" Command="{Binding CloseOthersCommand}" AutomationProperties.AutomationId="shell.ctxCloseOthers" />
          <MenuItem Header="{loc:Tr menu.window.rename}" Command="{Binding BeginRenameCommand}" AutomationProperties.AutomationId="shell.ctxRename" />
          <Separator />
          <MenuItem Header="{loc:Tr menu.window.toggleSdi}" Command="{Binding ToggleSdiCommand}" AutomationProperties.AutomationId="shell.ctxToggleSdi" />
          <MenuItem Header="{loc:Tr menu.window.pin}" Command="{Binding PinCommand}" AutomationProperties.AutomationId="shell.ctxPin" />
          <Separator />
          <!-- 즐겨찾기 넣기·빼기(22 §4): 대상은 위 항목과 같이 우클릭한 탭·창 문서(WindowTitleMenu 가 CommandParameter 를 맞춘다) -->
          <MenuItem Header="{loc:Tr favorite.toggle}" Command="{Binding FavoriteBar.ToggleCommand}" AutomationProperties.AutomationId="shell.ctxFavoriteToggle" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>

    <!-- 독립 창 아이콘(창 하나에 1개, 16 DIP): 활성은 강조 바탕, 비활성은 투명, 최소화는 흐린 글리프. 클릭은 활성화·복원, 우클릭은 활성화 없이 그 창에 §7.2 창 메뉴(대상 지정은 코드비하인드) -->
    <ItemsControl x:Name="SdiIcons"
                  Grid.Column="1"
                  Margin="4,0"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="shell.sdiIcons"
                  ItemsSource="{Binding TitleStrip.SdiItems}">
      <ItemsControl.Styles>
        <Style Selector="Button.sdiIcon /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
        <Style Selector="Button.sdiIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sdiIcon:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdChromeTabHoverBackground}" /></Style>
        <Style Selector="Button.sdiIcon.active /template/ ContentPresenter#PART_ContentPresenter, Button.sdiIcon.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sdiIcon.active:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdChromeTabActiveBackground}" /></Style>
        <Style Selector="Button.sdiIcon.active.minimized /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdChromeTabMinimizedBackground}" /></Style>
        <Style Selector="Button.sdiIcon PathIcon"><Setter Property="Foreground" Value="{DynamicResource PdChromeTabInactiveText}" /></Style>
        <Style Selector="Button.sdiIcon.active PathIcon"><Setter Property="Foreground" Value="{DynamicResource PdChromeTabActiveText}" /></Style>
        <Style Selector="Button.sdiIcon.minimized PathIcon"><Setter Property="Foreground" Value="{DynamicResource PdChromeTabMinimizedText}" /></Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SdiItem">
          <Button Classes="sdiIcon" Classes.active="{Binding IsActive}" Classes.minimized="{Binding IsMinimized}"
                  Width="16" Height="16" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0" CornerRadius="2"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  AutomationProperties.AutomationId="{Binding Id, StringFormat='shell.sdiIcon.{0}'}"
                  AutomationProperties.Name="{Binding ToolTip}"
                  ToolTip.Tip="{Binding ToolTip}"
                  Command="{Binding ActivateCommand}"><views:WindowIcon Document="{Binding Document}" Width="12" Height="12" /></Button><!-- 창 아이콘(22 §2.3 — 그 창에 보이는 문서의 화면 아이콘·불러오는 중) -->
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ContextMenu>
        <!-- 제목 탭 메뉴와 같은 항목·같은 대상 규칙(WindowMenuOps.TabTarget) -->
        <ContextMenu views:WindowTitleMenu.Kind="Tab">
          <MenuItem Header="{loc:Tr menu.window.closeOthers}" Command="{Binding CloseOthersCommand}" AutomationProperties.AutomationId="shell.ctxCloseOthers" />
          <MenuItem Header="{loc:Tr menu.window.rename}" Command="{Binding BeginRenameCommand}" AutomationProperties.AutomationId="shell.ctxRename" />
          <Separator />
          <MenuItem Header="{loc:Tr menu.window.toggleSdi}" Command="{Binding ToggleSdiCommand}" AutomationProperties.AutomationId="shell.ctxToggleSdi" />
          <MenuItem Header="{loc:Tr menu.window.pin}" Command="{Binding PinCommand}" AutomationProperties.AutomationId="shell.ctxPin" />
          <Separator />
          <!-- 즐겨찾기 넣기·빼기(22 §4): 대상은 위 항목과 같이 우클릭한 탭·창 문서(WindowTitleMenu 가 CommandParameter 를 맞춘다) -->
          <MenuItem Header="{loc:Tr favorite.toggle}" Command="{Binding FavoriteBar.ToggleCommand}" AutomationProperties.AutomationId="shell.ctxFavoriteToggle" />
        </ContextMenu>
      </ItemsControl.ContextMenu>
    </ItemsControl>

    <!-- 구분선 + 즐겨찾기 영역(REQ-113, 22 §4): 오른쪽부터 채우고, 폭 상한(max_width_pct)을 넘으면 » 팝업. 항목이 없거나 설정이 꺼지면 둘 다 숨는다 -->
    <Border x:Name="FavoriteSeparator" Grid.Column="2" Width="1" Margin="4,6" Background="{DynamicResource PdChromeTabInactiveText}" Opacity="0.35"
            IsVisible="{Binding FavoriteBar.IsShown}" />
    <views:FavoriteBarView x:Name="FavoriteBarHost" Grid.Column="3" Margin="0,0,4,0" DataContext="{Binding FavoriteBar}"
                           IsVisible="{Binding #FavoriteSeparator.IsVisible}" /><!-- 자기 DataContext 를 바꾸므로 표시 여부는 구분선 값을 따른다 -->
    </Grid>

    <!-- 도구모음 줄은 없앴다(공통원칙 §2-1): 테마 아이콘(shell.btnTheme)은 타이틀바 오른쪽 도구로, 설정은 시스템(Y)>설정 메뉴로 옮겼다. 글자 크기는 문서 창 위 Ctrl+휠/Ctrl+0 으로만 -->

    <!-- 레이아웃 저장·관리 패널(UI-11, 윈도우 메뉴 ⑪⑫) -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding WindowMenu.LayoutManager.IsOpen}">
      <views:LayoutManagerView DataContext="{Binding WindowMenu.LayoutManager}" />
    </Border>

    <!-- 이름 변경 패널 -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding IsRenaming}" Padding="6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{loc:Tr rename.label}" VerticalAlignment="Center" />
        <TextBox x:Name="RenameBox" Text="{Binding RenameText, Mode=TwoWay}" Width="260" AutomationProperties.AutomationId="shell.txtRename" />
        <Button Content="{loc:Tr common.ok}" Command="{Binding ConfirmRenameCommand}" IsDefault="True" />
        <Button Content="{loc:Tr common.cancel}" Command="{Binding CancelRenameCommand}" IsCancel="True" />
      </StackPanel>
    </Border>

    <views:ShellStatusBar DockPanel.Dock="Bottom" />

    <Grid>
      <!-- 넓은 폭: Dock 레이아웃(탐색기 | 문서 MDI/탭 / 로그). 좁은 폭에서는 숨기기만 하고 모델은 유지 -->
      <dock:DockControl x:Name="DockHost"
                        AutomationProperties.AutomationId="shell.dock"
                        IsVisible="{Binding Compact.IsWide}"
                        Layout="{Binding Layout}"
                        InitializeFactory="True"
                        InitializeLayout="False" />

      <!-- 좁은 폭(600px 미만): 모바일형 — MobileNavView(상단 ☰·문서·알림·닫기, 드로어, 하단 탭). 문서는 Body 의 CompactPresenter 가 Dock 캐시에서 가져온다 -->
      <views:MobileNavView IsVisible="{Binding Compact.IsCompact}">
        <views:MobileNavView.Body>
          <ContentControl x:Name="CompactPresenter" Content="{Binding #DockHost.((vm:MainViewModel)DataContext).Compact.CompactDocument}"
                          ControlRecyclingDataTemplate.ControlRecycling="{Binding #DockHost.(ControlRecyclingDataTemplate.ControlRecycling)}">
            <ContentControl.ContentTemplate>
              <ControlRecyclingDataTemplate Parent="{Binding #CompactPresenter}" />
            </ContentControl.ContentTemplate>
          </ContentControl>
        </views:MobileNavView.Body>
      </views:MobileNavView>

      <!-- 진행 표시(요건 2): 내용 영역 중앙 스피너와 브라우저·모바일용 포인터 추적 스피너. 둘 다 입력을 막지 않는다. 문서 창의 스피너는 DocumentViewLocator 가 문서마다 둔다 -->
      <ui:BusyOverlay Scope="main" AutomationProperties.AutomationId="shell.busyOverlay" />
      <ui:PointerFollower x:Name="BusyFollower" />
    </Grid>
  </DockPanel>
</UserControl>