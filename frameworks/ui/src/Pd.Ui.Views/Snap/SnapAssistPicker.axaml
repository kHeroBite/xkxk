<!-- 남은 칸 창 고르기(Snap Assist) 후보 카드 목록 — 활성 칸 안에 카드(썸네일 또는 아이콘 + 창 제목)를 줄 바꿈으로 늘어놓는다. 색은 테마 토큰만 쓴다(11 문서 §3.9) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:snap="using:Pd.Ui.Views.Snap"
             x:Class="Pd.Ui.Views.Snap.SnapAssistPicker"
             Focusable="False">
  <UserControl.Styles>
    <!-- 카드: 표면색 바탕 + 둥근 모서리 6. 포인터가 올라가면 배경색만 바꾼다(외곽선 없음). 테두리 두께 2 는 늘 두고 색만 바꿔 초점 때 크기가 흔들리지 않게 한다 -->
    <Style Selector="Border.pdAssistCard">
      <Setter Property="Background" Value="{DynamicResource PdBrushSurface}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #30000000" />
    </Style>
    <Style Selector="Border.pdAssistCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource PdBrushSurfaceAlt}" />
    </Style>
    <!-- 키보드 초점 카드(Tab·방향키): 강조색 테두리 2 -->
    <Style Selector="Border.pdAssistCard.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource PdBrushAccent}" />
    </Style>
    <!-- 썸네일 칸: 보조 표면색 바탕(썸네일이 칸보다 작을 때 여백 색) -->
    <Style Selector="Border.pdAssistThumb">
      <Setter Property="Background" Value="{DynamicResource PdBrushSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- 썸네일이 없을 때 보이는 대체 그림: 큰 창 아이콘(테두리 사각형 + 제목줄 띠) 안에 제목 첫 글자 -->
    <Style Selector="Border.pdAssistIcon">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="54" />
      <Setter Property="BorderBrush" Value="{DynamicResource PdBrushTextMuted}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pdAssistIconBar">
      <Setter Property="Height" Value="10" />
      <Setter Property="Background" Value="{DynamicResource PdBrushTextMuted}" />
    </Style>
    <Style Selector="TextBlock.pdAssistInitial">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PdBrushText}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 이름표: 썸네일 칸 아래 한 덩어리(작은 창 아이콘 + 제목 최대 2줄 + 보조 표기) -->
    <Style Selector="Grid.pdAssistLabel">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Width" Value="{x:Static snap:SnapAssistCard.ThumbWidth}" />
    </Style>
    <Style Selector="Border.pdAssistIconSmall">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Margin" Value="0,2,6,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="BorderBrush" Value="{DynamicResource PdBrushTextMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.pdAssistIconBarSmall">
      <Setter Property="Height" Value="3" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource PdBrushTextMuted}" />
    </Style>
  </UserControl.Styles>
  <!-- 카드가 칸보다 많으면 세로 스크롤. 스크롤·목록은 포커스를 받지 않는다(키 입력은 SnapAssistLayer 가 받는다) -->
  <ScrollViewer x:Name="Scroller"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="Cards" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="snap:SnapAssistCard">
          <Border Classes="pdAssistCard"
                  Classes.focused="{Binding IsFocused}"
                  Width="{x:Static snap:SnapAssistCard.CardWidth}"
                  AutomationProperties.AutomationId="{Binding AutomationId}"
                  AutomationProperties.Name="{Binding AccessibleName}"
                  ToolTip.Tip="{Binding Title}">
            <!-- 위: 고정 크기 썸네일 칸(행 0) / 아래: 이름표(행 1). 두 행이 나뉘어 이름표가 썸네일 위에 겹치지 않는다 -->
            <Grid RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Classes="pdAssistThumb"
                      Width="{x:Static snap:SnapAssistCard.ThumbWidth}"
                      Height="{Binding SlotHeight}"
                      AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='{}{0}.thumb'}">
                <Panel>
                  <!-- 창 전체를 줄인 비트맵: 칸 안에 비율 유지로 맞춘다(가운데) -->
                  <Image Source="{Binding Image}"
                         IsVisible="{Binding HasImage}"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                  <!-- 대체 카드(캡처 실패·썸네일 끔): 같은 크기 칸에 큰 창 아이콘(제목줄 띠 + 제목 첫 글자) + 보조 표기 -->
                  <StackPanel IsVisible="{Binding !HasImage}" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Classes="pdAssistIcon">
                      <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="pdAssistIconBar" />
                        <TextBlock Grid.Row="1" Classes="pdAssistInitial" Text="{Binding Initial}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Note}"
                               AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='{}{0}.note'}"
                               FontSize="{DynamicResource PdFontCaption}"
                               Foreground="{DynamicResource PdBrushTextMuted}"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Panel>
              </Border>
              <!-- 이름표(작은 창 아이콘 + 제목 최대 2줄, 넘치면 말줄임 + 같은 제목 구분 #순번): 썸네일 칸 아래에만 -->
              <Grid Grid.Row="1" Classes="pdAssistLabel" ColumnDefinitions="Auto,*"
                    AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='{}{0}.label'}">
                <Border Grid.Column="0" Classes="pdAssistIconSmall">
                  <Border Classes="pdAssistIconBarSmall" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Title}"
                             FontSize="{DynamicResource PdFontCaption}"
                             Foreground="{DynamicResource PdBrushText}"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             MaxLines="2" />
                  <TextBlock Text="{Binding Subtitle}"
                             IsVisible="{Binding HasSubtitle}"
                             FontSize="{DynamicResource PdFontCaption}"
                             Foreground="{DynamicResource PdBrushTextMuted}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
