<Project Sdk="Microsoft.NET.Sdk">
  <!-- PD UI PoC 데스크톱(Windows·macOS) 호스트 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>xkxk.frameworks.ui.desktop</RootNamespace>
    <AssemblyName>xkxk.frameworks.ui.desktop</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 게시(-r <RID>) 때 ReadyToRun 사전 컴파일: 첫 프레임 JIT 비용 절감(실측 logs/odev4b diag4). 일반 build 에는 영향 없음 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 앱 아이콘(tools/make_icons.py 생성): exe 아이콘. Avalonia 12.1.4 targets 가 같은 파일을 !__AvaloniaDefaultWindowIcon 로 내장한다.
         ShellPlatform.AppIcon 이 이 자원을 읽고, AppWindowIcon 이 작업표시줄에 뜨는 창에 명시로 지정한다(트레이도 같은 원천) -->
    <ApplicationIcon>Assets\pd.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\xkxk.frameworks.ui.shell\xkxk.frameworks.ui.shell.csproj" />
    <ProjectReference Include="..\xkxk.frameworks.ui.views\xkxk.frameworks.ui.views.csproj" />
    <ProjectReference Include="..\..\testbed\xkxk.frameworks.ui.testbed\xkxk.frameworks.ui.testbed.csproj" />
  </ItemGroup>
</Project>
