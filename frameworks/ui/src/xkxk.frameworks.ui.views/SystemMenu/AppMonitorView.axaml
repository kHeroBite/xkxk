<!-- 앱 자원 모니터 화면(UI-17 모니터링 ▶) — 관리 힙·작업 집합·GC 횟수·스레드·가동 시간·렌더러를 1초마다 표시. 문자열은 다국어 사전 키 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xkxk.frameworks.ui.shell.ViewModels.SystemMenu"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             x:Class="xkxk.frameworks.ui.views.SystemMenu.AppMonitorView"
             x:DataType="vm:AppMonitorViewModel">
  <StackPanel Margin="14" Spacing="8">
    <TextBlock Text="{loc:Tr sysview.monitor.scope}" Opacity="0.75" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
      <TextBlock Grid.Row="0" Text="{loc:Tr sysview.monitor.managed}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ManagedMb}" AutomationProperties.AutomationId="sys.monitor.managed" />
      <TextBlock Grid.Row="1" Text="{loc:Tr sysview.monitor.workingSet}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorkingSetMb}" AutomationProperties.AutomationId="sys.monitor.workingSet" />
      <TextBlock Grid.Row="2" Text="{loc:Tr sysview.monitor.gc}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gc}" AutomationProperties.AutomationId="sys.monitor.gc" />
      <TextBlock Grid.Row="3" Text="{loc:Tr sysview.monitor.threads}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Threads}" AutomationProperties.AutomationId="sys.monitor.threads" />
      <TextBlock Grid.Row="4" Text="{loc:Tr sysview.monitor.uptime}" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Uptime}" AutomationProperties.AutomationId="sys.monitor.uptime" />
      <TextBlock Grid.Row="5" Text="{loc:Tr sysview.monitor.renderer}" />
      <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Renderer}" TextWrapping="Wrap" AutomationProperties.AutomationId="sys.monitor.renderer" />
    </Grid>
  </StackPanel>
</UserControl>
