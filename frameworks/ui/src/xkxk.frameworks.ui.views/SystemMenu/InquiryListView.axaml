<!-- 문의목록 화면(UI-17) — 로컬 임시함 목록(작성 시각·분류·제목·상태)과 선택 항목 본문, 새로고침·삭제. 문자열은 다국어 사전 키 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xkxk.frameworks.ui.shell.ViewModels.SystemMenu"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             xmlns:input="using:xkxk.frameworks.ui.Input"
             x:Class="xkxk.frameworks.ui.views.SystemMenu.InquiryListView"
             x:DataType="vm:InquiryListViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12" RowSpacing="6">
    <TextBlock Grid.Row="0" Text="{loc:Tr sysview.server.offline}" Opacity="0.75" TextWrapping="Wrap" />
    <Grid Grid.Row="1">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" MinHeight="120"
               AutomationProperties.AutomationId="sys.inquiryList.list" input:DenseList.Enable="True" input:DenseList.LocalFont="True">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:InquiryRow">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Text="{Binding Time}" Opacity="0.75" />
              <TextBlock Grid.Column="1" Text="{Binding Category}" />
              <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Status}" Opacity="0.75" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{loc:Tr sysview.inquiry.empty}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Opacity="0.6" AutomationProperties.AutomationId="sys.inquiryList.lblEmpty" />
    </Grid>
    <SelectableTextBlock Grid.Row="2" Text="{Binding SelectedBody}" TextWrapping="Wrap" MaxHeight="160"
                         AutomationProperties.AutomationId="sys.inquiryList.txtBody" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button Content="{loc:Tr sysview.refresh}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="sys.inquiryList.btnRefresh" />
      <Button Content="{loc:Tr common.delete}" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="sys.inquiryList.btnDelete" />
    </StackPanel>
  </Grid>
</UserControl>
