<!-- 제목줄 '시스템' 상위 메뉴(UI-17) — 설정 창 열기·모니터·로그·문의·업데이트·도움말 -->
<!-- 시스템 메뉴(UI-17, Mars 시스템 메뉴 대응 — DB 데이터 관리는 pd-admin 으로 뺐다). 창 항목은 SystemHost.Views(odev-1r), 불가 플랫폼은 비활성 -->
<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:vm="using:xkxk.frameworks.ui.shell.ViewModels"
          xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
          xmlns:nav="using:xkxk.frameworks.ui.data.Navigation"
          xmlns:menus="using:xkxk.frameworks.ui.views.Menus"
          x:Class="xkxk.frameworks.ui.views.Menus.SystemMenuItem"
          x:DataType="vm:MainViewModel"
          Header="{loc:Tr menu.sys}" AutomationProperties.AutomationId="shell.mnuSys">
  <!-- 요건 7: 디버그·GPU·중복 실행·로그 레벨 값은 설정 창(시스템 범주)으로 옮겼다. 재시작 대기 안내는 설정값이 아니라 동작이라 여기 남는다 -->
  <MenuItem Header="{loc:Tr menu.sys.settings}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="Settings" menus:MenuIcon.Key="PdShellIconSettings" AutomationProperties.AutomationId="shell.mnuSysSettings" />
  <MenuItem Header="{loc:Tr sys.restartRequired.title}" IsVisible="{Binding SystemMenu.SysGpuRestartPending}"
            Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="RestartRequired" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.GpuRestart}" AutomationProperties.AutomationId="shell.mnuSysGpuRestart" />
  <Separator />
  <MenuItem Header="{loc:Tr menu.sys.monitor}" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.SysMonitor}" AutomationProperties.AutomationId="shell.mnuSysMonitor">
    <MenuItem Header="{loc:Tr menu.sys.monitor.app}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="AppMonitor" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.AppMonitor}" AutomationProperties.AutomationId="shell.mnuSysMonitorApp" />
  </MenuItem>
  <MenuItem Header="{loc:Tr menu.sys.log}" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.LogGroup}" AutomationProperties.AutomationId="shell.mnuSysLog">
    <MenuItem Header="{loc:Tr menu.sys.log.view}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="LogView" menus:MenuIcon.Key="PdShellIconLog" AutomationProperties.AutomationId="shell.mnuSysLogView" />
    <MenuItem Header="{loc:Tr menu.sys.log.openFolder}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="LogFolder"
              ToolTip.Tip="{Binding SystemMenu.SysLogFolderTip}" ToolTip.ShowOnDisabled="True" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.LogFolder}" AutomationProperties.AutomationId="shell.mnuSysLogFolder" />
    <MenuItem Header="{loc:Tr menu.sys.log.export}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="LogExport" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.LogExport}" AutomationProperties.AutomationId="shell.mnuSysLogExport" />
  </MenuItem>
  <Separator />
  <MenuItem Header="{loc:Tr menu.sys.inquiry}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="Inquiry" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.Inquiry}" AutomationProperties.AutomationId="shell.mnuSysInquiry" />
  <MenuItem Header="{loc:Tr menu.sys.inquiryList}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="InquiryList" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.InquiryList}" AutomationProperties.AutomationId="shell.mnuSysInquiryList" />
  <Separator />
  <MenuItem Header="{loc:Tr menu.sys.update}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="Update" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.Update}" AutomationProperties.AutomationId="shell.mnuSysUpdate" />
  <MenuItem Header="{loc:Tr menu.sys.changelog}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="Changelog" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.Changelog}" AutomationProperties.AutomationId="shell.mnuSysChangelog" />
  <MenuItem Header="{loc:Tr menu.sys.help}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="Help" menus:MenuIcon.Key="PdShellIconHelp" AutomationProperties.AutomationId="shell.mnuSysHelp" />
  <MenuItem Header="{loc:Tr menu.sys.about}" Command="{Binding SystemMenu.SystemViewCommand}" CommandParameter="About" menus:MenuIcon.Key="{x:Static nav:CmdIconKeys.About}" AutomationProperties.AutomationId="shell.mnuSysAbout" />
</MenuItem>
