<!-- 테마 편집기 화면(UI-07) — 테마 목록·복제·삭제·시스템 짝, 토큰별 hex 색 편집(즉시 미리보기), 이름 저장, JSON 내보내기/가져오기. 색·글자 크기는 토큰만 사용 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xkxk.frameworks.ui.shell.ViewModels"
             xmlns:th="using:xkxk.frameworks.ui.shell.Theming"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             xmlns:v="using:xkxk.frameworks.ui.views"
             x:Class="xkxk.frameworks.ui.views.ThemeEditorView"
             x:DataType="vm:ThemeEditorViewModel"
             Background="{DynamicResource PdBrushBackground}"
             Foreground="{DynamicResource PdBrushText}"
             MinWidth="640" MinHeight="480">

  <UserControl.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource PdFontCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource PdBrushTextMuted}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource PdFontSubtitle}" />
      <Setter Property="FontWeight" Value="{DynamicResource PdFontWeightStrong}" />
    </Style>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource PdBrushError}" />
    </Style>
  </UserControl.Styles>

  <!-- 넓은 폭은 스크롤 없이 칸이 높이를 채운다. 좁은 폭은 코드비하인드(OnSizeChanged)가 위아래로 쌓고 세로 스크롤을 켠다 -->
  <ScrollViewer x:Name="RootScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
  <DockPanel Margin="12">
    <!-- 하단: 상태 + JSON 교환 -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
      <WrapPanel>
        <Button AutomationProperties.AutomationId="theme.btnExportFile" Content="{loc:Tr theme.ui.exportFile}" Click="OnExportFile" Margin="0,0,6,6" />
        <Button AutomationProperties.AutomationId="theme.btnImportFile" Content="{loc:Tr theme.ui.importFile}" Click="OnImportFile" Margin="0,0,6,6" />
        <Button AutomationProperties.AutomationId="theme.btnExport" Content="{loc:Tr theme.ui.exportText}" Command="{Binding ExportTextCommand}" Margin="0,0,6,6" />
        <Button AutomationProperties.AutomationId="theme.btnImport" Content="{loc:Tr theme.ui.importText}" Command="{Binding ImportTextCommand}" Margin="0,0,6,6" />
      </WrapPanel>
      <TextBox x:Name="ExchangeBox" AutomationProperties.AutomationId="theme.txtJson" Text="{Binding ExchangeText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
               Height="80" PlaceholderText="{loc:Tr theme.ui.jsonWatermark}" />
      <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="theme.lblStatus" Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
    </StackPanel>

    <Grid x:Name="EditorGrid" ColumnDefinitions="220,12,*">
      <!-- 왼쪽: 테마 목록 -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr theme.ui.themes}" Classes="section" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <UniformGrid Columns="2">
            <Button x:Name="DuplicateButton" AutomationProperties.AutomationId="theme.btnClone" Content="{loc:Tr theme.ui.clone}" Command="{Binding DuplicateCommand}" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="theme.btnDelete" Content="{loc:Tr theme.ui.delete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
          </UniformGrid>
          <CheckBox x:Name="FollowSystemCheck" AutomationProperties.AutomationId="theme.chkSystem" Content="{loc:Tr theme.ui.followSystem}" IsChecked="{Binding Pairs.FollowSystem, Mode=TwoWay}" />
          <TextBlock Text="{loc:Tr theme.ui.whenLight}" Classes="caption" />
          <!-- 항목 표시는 ToString(갱신 알림 없음)이 아니라 DisplayName 바인딩 — 언어 전환 시 '(내장)'·내장 이름이 즉시 바뀐다(Q17) -->
          <ComboBox AutomationProperties.AutomationId="theme.cboLight" ItemsSource="{Binding Pairs.LightThemes}" SelectedItem="{Binding Pairs.SystemLightTheme, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    Text="{Binding Pairs.SystemLightTheme.DisplayName, Mode=OneWay}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="th:ThemeDefinition"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{loc:Tr theme.ui.whenDark}" Classes="caption" />
          <ComboBox AutomationProperties.AutomationId="theme.cboDark" ItemsSource="{Binding Pairs.DarkThemes}" SelectedItem="{Binding Pairs.SystemDarkTheme, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    Text="{Binding Pairs.SystemDarkTheme.DisplayName, Mode=OneWay}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="th:ThemeDefinition"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <ListBox x:Name="ThemeList" AutomationProperties.AutomationId="theme.cboTheme" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                 BorderBrush="{DynamicResource PdBrushBorder}" BorderThickness="1">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="th:ThemeDefinition">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- 오른쪽: 이름·기반 + 토큰 색 -->
      <!-- 영역 탭: 색 토큰 / 요소별 디자인(REQ-101). ColorsPanel 이름은 코드비하인드 폼팩터 배치가 쓰므로 TabControl 이 가진다 -->
      <TabControl x:Name="ColorsPanel" Grid.Column="2" AutomationProperties.AutomationId="theme.tabArea">
      <TabItem AutomationProperties.AutomationId="theme.tabColors" Header="{loc:Tr theme.ui.colors}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <TextBlock Text="{loc:Tr theme.ui.colors}" Classes="section" />
          <TextBlock Text="{loc:Tr theme.ui.builtinReadOnly}" Classes="caption" IsVisible="{Binding IsBuiltinSelected}" />
          <Grid ColumnDefinitions="*,Auto,Auto" IsEnabled="{Binding IsEditable}">
            <TextBox x:Name="NameBox" AutomationProperties.AutomationId="theme.txtName" Grid.Column="0" Text="{Binding EditName, Mode=TwoWay}" PlaceholderText="{loc:Tr theme.ui.nameWatermark}" />
            <CheckBox Grid.Column="1" AutomationProperties.AutomationId="theme.chkDark" Content="{loc:Tr theme.ui.darkBase}" IsChecked="{Binding EditIsDark, Mode=TwoWay}" Margin="8,0" />
            <Button x:Name="SaveNameButton" AutomationProperties.AutomationId="theme.btnSave" Grid.Column="2" Content="{loc:Tr theme.ui.saveName}" Command="{Binding SaveNameCommand}" />
          </Grid>
        </StackPanel>
        <ScrollViewer x:Name="TokenScroll">
          <ItemsControl x:Name="TokenList" AutomationProperties.AutomationId="theme.lstTokens" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeTokenRow">
                <Grid ColumnDefinitions="Auto,*,120,Auto" Margin="0,2">
                  <!-- 내장 테마: 견본만(읽기 전용), 사용자 테마: ColorPicker(Avalonia.Controls.ColorPicker 12.1.4, MIT) -->
                  <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,8,0"
                          BorderBrush="{DynamicResource PdBrushBorder}" BorderThickness="1" VerticalAlignment="Center"
                          IsVisible="{Binding IsReadOnly}" />
                  <ColorPicker Grid.Column="0" Color="{Binding Color, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="{Binding Key, StringFormat='theme.pickColor.{0}'}"
                               IsVisible="{Binding !IsReadOnly}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Key}" Classes="caption" />
                  </StackPanel>
                  <TextBox Grid.Column="2" AutomationProperties.AutomationId="{Binding Key, StringFormat='theme.txtColor.{0}'}" Text="{Binding Hex, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}"
                           Classes.invalid="{Binding !IsValid}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" AutomationProperties.AutomationId="{Binding Key, StringFormat='theme.btnResetToken.{0}'}" Content="{loc:Tr theme.design.resetToken}"
                          Command="{Binding ResetToTemplateCommand}" IsVisible="{Binding !IsReadOnly}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      </TabItem>
      <TabItem AutomationProperties.AutomationId="theme.tabDesign" Header="{loc:Tr theme.design.tab}">
        <v:ThemeDesignPanel DataContext="{Binding Design}" />
      </TabItem>
      <TabItem AutomationProperties.AutomationId="theme.tabDesignTheme" Header="{loc:Tr theme.style.section}">
        <v:DesignThemePanel DataContext="{Binding DesignTheme}" />
      </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
  </ScrollViewer>
</UserControl>
