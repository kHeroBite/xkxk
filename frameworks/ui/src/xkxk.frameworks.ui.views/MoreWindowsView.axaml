<!-- '창 더 보기…' 대화상자(Win32 MDI 관례) — 열린 창 전체 목록, 확인·더블클릭으로 활성화(최소화면 복원), 취소. 데이터는 OpenWindowListViewModel -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xkxk.frameworks.ui.shell.ViewModels"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             x:Class="xkxk.frameworks.ui.views.MoreWindowsView"
             x:DataType="vm:OpenWindowListViewModel"
             AutomationProperties.AutomationId="shell.moreWindows">
  <Border Background="{DynamicResource PdBrushSurface}" BorderBrush="{DynamicResource PdBrushBorder}" BorderThickness="1"
          CornerRadius="6" Padding="12" Width="360" BoxShadow="0 4 16 0 #40000000">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{loc:Tr moreWindows.title}" FontWeight="{DynamicResource PdFontWeightStrong}" Margin="0,0,0,8" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
        <Button Content="{loc:Tr common.ok}" IsDefault="True" Command="{Binding ConfirmMoreCommand}" MinWidth="72"
                AutomationProperties.AutomationId="shell.moreWindowsOk" />
        <Button Content="{loc:Tr common.cancel}" IsCancel="True" Command="{Binding CancelMoreCommand}" MinWidth="72"
                AutomationProperties.AutomationId="shell.moreWindowsCancel" />
      </StackPanel>
      <!-- 더블클릭·Enter = 확인(코드 비하인드 OnListDoubleTapped·OnListKeyDown). Enter 는 ListBoxItem 이 버블 전에 소비하므로 터널링 구독이라 생성자에서 단다(XAML 에 터널링 문법 없음) -->
      <ListBox x:Name="List" ItemsSource="{Binding MoreEntries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" MaxHeight="360"
               DoubleTapped="OnListDoubleTapped" AutomationProperties.AutomationId="shell.moreWindowsList">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OpenWindowSlot">
            <!-- 활성 창은 굵게(메뉴의 ✓ 에 해당) -->
            <TextBlock Text="{Binding Header}" Classes.pdActive="{Binding IsActive}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.pdActive"><Setter Property="FontWeight" Value="{DynamicResource PdFontWeightStrong}" /></Style>
              </TextBlock.Styles>
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
