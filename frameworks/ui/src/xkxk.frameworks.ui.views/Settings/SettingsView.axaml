<!-- 통합 설정 창 조립(요건 7) — SettingsShell(xkxk.frameworks.ui)에 뷰모델·페이지 템플릿·버튼을 끼운다. 페이지 전환은 뷰모델 형식별 DataTemplate 이 맡는다 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="using:xkxk.frameworks.ui.shell.ViewModels.Settings"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             xmlns:ui="using:xkxk.frameworks.ui.Controls"
             xmlns:pages="using:xkxk.frameworks.ui.views.Settings"
             x:Class="xkxk.frameworks.ui.views.Settings.SettingsView"
             x:DataType="vms:SettingsWindowViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vms:AppearancePageViewModel"><pages:AppearancePage /></DataTemplate>
    <DataTemplate DataType="vms:WindowPageViewModel"><pages:WindowPage /></DataTemplate>
    <DataTemplate DataType="vms:LanguagePageViewModel"><pages:LanguagePage /></DataTemplate>
    <DataTemplate DataType="vms:LayoutPageViewModel"><pages:LayoutPage /></DataTemplate>
    <DataTemplate DataType="vms:SystemPageViewModel"><pages:SystemPage /></DataTemplate>
  </UserControl.DataTemplates>
  <ui:SettingsShell Categories="{Binding Categories}" SelectedCategory="{Binding SelectedCategory, Mode=TwoWay}"
                    PageContent="{Binding SelectedPage}" SearchText="{Binding SearchText, Mode=TwoWay}"
                    SearchWatermark="{loc:Tr settings.search.watermark}" EmptyText="{loc:Tr settings.search.none}" IsEmpty="{Binding HasNoResults}">
    <ui:SettingsShell.CategoryTemplate>
      <DataTemplate x:DataType="vms:SettingsCategoryItem">
        <TextBlock Text="{Binding Title}" AutomationProperties.AutomationId="{Binding AutomationId}" />
      </DataTemplate>
    </ui:SettingsShell.CategoryTemplate>
    <ui:SettingsShell.Footer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{loc:Tr settings.reset.category}" Command="{Binding ResetSelectedCommand}" AutomationProperties.AutomationId="settings.btnResetCategory" />
        <Button Content="{loc:Tr settings.reset.all}" Command="{Binding ResetAllCommand}" AutomationProperties.AutomationId="shell.btnSettingsReset" />
        <Button Content="{loc:Tr common.close}" Click="OnClose" AutomationProperties.AutomationId="settings.btnClose" />
      </StackPanel>
    </ui:SettingsShell.Footer>
  </ui:SettingsShell>
</UserControl>
