<!-- 간트 500 작업 문서 화면(줌 도구줄 + 직접 렌더 캔버스 + 가로·세로 스크롤바). 글자는 셸 토큰(PdFont*)을 따른다 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             x:Class="xkxk.frameworks.ui.views.Documents.GanttDocumentView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="6,4" Background="{DynamicResource PdBrushSurfaceAlt}">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <Button x:Name="ZoomOutButton" AutomationProperties.AutomationId="gantt.btnZoomOut" AutomationProperties.Name="{loc:Tr doc.gantt.zoomOut}" ToolTip.Tip="{loc:Tr doc.gantt.zoomOut}" Content="－" MinWidth="32" />
        <Button x:Name="ZoomInButton" AutomationProperties.AutomationId="gantt.btnZoomIn" AutomationProperties.Name="{loc:Tr doc.gantt.zoomIn}" ToolTip.Tip="{loc:Tr doc.gantt.zoomIn}" Content="＋" MinWidth="32" />
        <TextBlock x:Name="ZoomText" AutomationProperties.AutomationId="gantt.lblZoom" VerticalAlignment="Center" FontSize="{DynamicResource PdFontDetail}" />
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource PdBrushTextMuted}" FontSize="{DynamicResource PdFontDetail}" />
        <!-- 조작 안내는 줄바꿈 허용: 영어 문구가 길어 좁은 폭에서 잘렸다(Q17). 터치 기기는 툴팁을 볼 수 없어 짧은 문구+툴팁 대신 전문을 보이게 한다. 한 줄에 들어가면(한국어) 배치는 같다 -->
        <TextBlock Text="{loc:Tr doc.gantt.wheel.tip}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource PdBrushTextMuted}" FontSize="{DynamicResource PdFontCaption}" />
      </WrapPanel>
    </Border>
    <!-- 스크롤바는 그리드(ScrollViewer)처럼 캔버스 위에 겹친 얇은 자동 숨김 막대다(사용자 요청 2번, 2026-11-10). 세로는 오른쪽, 가로는 아래에 붙인다 -->
    <Grid>
      <Border x:Name="CanvasHost" />
      <ScrollBar x:Name="VBar" AutomationProperties.AutomationId="gantt.vScroll" Orientation="Vertical" HorizontalAlignment="Right" />
      <ScrollBar x:Name="HBar" AutomationProperties.AutomationId="gantt.hScroll" Orientation="Horizontal" VerticalAlignment="Bottom" />
    </Grid>
  </DockPanel>
</UserControl>
