<!-- 메인 창 통합 제목줄(Q14) — [로고][파일·창·보기·시스템 메뉴(U16)][끌기 빈칸][테마 아이콘][UI 형 4칸 아이콘][최소화][최대화][닫기] 한 줄. 데스크톱은 OS 제목줄 대신, 웹·Android 는 캡션 버튼 없이 같은 배치 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xkxk.frameworks.ui.shell.ViewModels"
             xmlns:views="using:xkxk.frameworks.ui.views"
             xmlns:menus="using:xkxk.frameworks.ui.views.Menus"
             xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:snap="using:xkxk.frameworks.ui.views.Snap"
             x:Class="xkxk.frameworks.ui.views.MainTitleBar"
             x:DataType="vm:MainViewModel" Classes="pdTitleBar">
  <!-- ElementRole(비클라이언트 판정, Avalonia 12): 빈칸=TitleBar(OS 끌기·더블클릭 최대화·Aero Snap), 캡션 버튼=Minimize/Maximize/CloseButton(Win11 스냅 레이아웃),
       메뉴·로고=User(입력은 요소로). 호스트가 ExtendClientAreaToDecorationsHint=true 일 때만 효과가 있다(odev-4b MainWindowChrome) -->
  <!-- 색: 메인 타이틀바 전용 토큰(PdBrushMainTitle*). 창 스타일에 따라 표면색이 되는 문서 창 별칭(PdChrome*)을 쓰면 macOS 스타일 등에서 아래 제목 줄과 구분되지 않으므로 쓰지 않는다(공통원칙 §4.2).
       상위 메뉴·캡션 버튼은 Fluent 기본색이 표면색 기준이라 여기서 맞춘다. 팝업이 물려받지 않도록 Bar 의 TextElement.Foreground 는 본문 글자색으로 둔다. 여기 스타일이 앱 스타일보다 가까워 우선한다 -->
  <Border x:Name="Bar" Height="32"
          TextElement.Foreground="{DynamicResource PdBrushText}" AutomationProperties.AutomationId="shell.titleBar">
    <Border.Styles>
      <!-- 창 비활성(기준 05_창크롬 §1 "비활성 창 제목줄" 반투명): MDI·SDI 와 같은 투명도 토큰 + 비활성 바탕 토큰 -->
      <Style Selector="Border#Bar"><Setter Property="Background" Value="{DynamicResource PdBrushMainTitleBar}" /></Style>
      <Style Selector="Border#Bar.inactive"><Setter Property="Background" Value="{DynamicResource PdBrushMainTitleBarInactive}" /></Style>
      <Style Selector="Border#Bar.inactive > Grid"><Setter Property="Opacity" Value="{DynamicResource PdChromeInactiveOpacity}" /></Style>
      <Style Selector="Button.pdChrome.pdLogo, Button.pdChrome.pdOp">
        <Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" />
      </Style>
      <!-- hover·누름은 강조 띠 위 제목줄 버튼 토큰(MDI 와 같다). 표면색용 캡션 토큰은 진한 바탕에서 거의 보이지 않는다 -->
      <Style Selector="Button.pdChrome.pdOp:not(.pdClose):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PdBrushMdiTitleButtonHover}" />
      </Style>
      <Style Selector="Button.pdChrome.pdOp:not(.pdClose):pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PdBrushMainTitleText}" />
        <Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleBar}" />
      </Style>
      <!-- 상위 메뉴만(더보기로 옮겨진 메뉴·하위 항목은 팝업 표면이라 제외). Fluent 는 hover·열림을 :selected 로 표시하고 그때 글자색을 표면색 기준으로 바꾼다 -->
      <Style Selector="Menu#MainMenu > MenuItem"><Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" /></Style>
      <Style Selector="Menu#MainMenu > MenuItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource PdBrushMdiTitleButtonHover}" /></Style>
      <Style Selector="Menu#MainMenu > MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter"><Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" /></Style>
      <Style Selector="Menu#MainMenu > MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover"><Setter Property="Background" Value="{DynamicResource PdBrushMdiTitleButtonHover}" /></Style>
      <Style Selector="Menu#MainMenu > MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover ContentPresenter#PART_HeaderPresenter"><Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" /></Style>
      <!-- 키보드 포커스 표시(AC-025): 전역 FocusVisual 의 강조색 1px 는 강조색 제목줄 바탕에 묻힌다. 제목줄 오른쪽 도구·캡션 단추에만 제목줄 글자색 2px 안쪽 링을 쓴다.
           FocusAdorner 는 키보드 포커스(:focus-visible)일 때만 그려지므로 hover·누름에는 테두리가 생기지 않는다. 팝업(창 더 보기)은 표면색이라 범위에서 뺀다.
           대비(글자색 대 제목줄 바탕, 내장 7종): 활성 4.53~14.67:1, 비활성 바탕 4.71~8.49:1 — 모두 ≥ 3:1 (odev-11 계산) -->
      <Style Selector="StackPanel#TitleTools Button, StackPanel#CaptionButtons Button">
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <!-- Margin 0: 링이 단추 경계(0~2px)에 붙는다. UI 형 스위치 자동 판정 점(칸 아래 18~21px)과 링 안쪽 가장자리(22px) 사이를 1px 띄우기 위함(역라우팅 3차) -->
            <Border BorderThickness="2" BorderBrush="{DynamicResource PdBrushMainTitleText}" CornerRadius="4" Margin="0" IsHitTestVisible="False" />
          </FocusAdornerTemplate>
        </Setter>
      </Style>
      <!-- 캡션 기호 기준선(이월 6): 버튼 높이 32 가운데(중심 16)였던 기호를 아래 여백 2 로 1px 올려 UI 형 스위치 기호(중심 15)와 맞춘다 -->
      <Style Selector="StackPanel#CaptionButtons Button PathIcon">
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style Selector="Button.pdChrome.pdClose:pointerover">
        <Setter Property="Foreground" Value="White" />
      </Style>
      <Style Selector="Button.pdChrome.pdClose:pressed">
        <Setter Property="Foreground" Value="{DynamicResource PdBrushCaptionClosePressedGlyph}" />
      </Style>
    </Border.Styles>
    <Border.ContextMenu>
      <!-- 항목은 공통 컴포넌트(WindowTitleMenu). 끌기 빈칸·캡션 버튼 우클릭은 비클라이언트 영역이라 호스트 훅(MainNcMenuHook)이 이 메뉴를 연다. 웹·Android 는 코드비하인드가 메뉴를 뗀다(W-20) -->
      <ContextMenu x:Name="SystemMenu" views:WindowTitleMenu.Kind="Main" />
    </Border.ContextMenu>
    <!-- 바깥 칸 *,Auto: 캡션 버튼 칸(Auto)을 먼저 잡고 나머지를 안쪽 칸에 준다 — 창 폭 504(컴팩트)에서 최대화·닫기가 창 밖으로 밀리던 결함(otest-12).
         안쪽은 넘치면 잘린다(ClipToBounds). 넓은 폭에서는 배치가 예전 한 줄 Grid 와 같다 -->
    <Grid ColumnDefinitions="*,Auto,Auto">
    <!-- '창 더 보기…' 대화상자(U16, Win32 MDI 관례): 제목줄 아래 가운데. 팝업이라 데스크톱·웹·Android 에서 같은 화면을 쓴다. 바깥 클릭·Esc(취소)로 닫힘 -->
    <Popup Grid.ColumnSpan="3" PlacementTarget="{Binding #Bar}" Placement="Bottom" IsLightDismissEnabled="True"
           IsOpen="{Binding WindowMenu.OpenWindows.IsMoreOpen, Mode=TwoWay}">
      <views:MoreWindowsView DataContext="{Binding WindowMenu.OpenWindows}" />
    </Popup>
    <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*" ClipToBounds="True">
      <views:ChromeLogo x:Name="Logo" Grid.Column="0" Classes="pdChrome pdLogo" chrome:WindowDecorationProperties.ElementRole="User"
                        AutomationProperties.AutomationId="shell.titleLogo" ToolTip.Tip="{loc:Tr titlebar.appMenu}">
        <Image Source="avares://xkxk.frameworks.ui.views/Assets/Logo/pd-logo-64.png" Width="{DynamicResource PdLogoIconSize}" Height="{DynamicResource PdLogoIconSize}" RenderOptions.BitmapInterpolationMode="HighQuality" />
      </views:ChromeLogo>

      <!-- 로고와 메뉴 사이 끌기 여백(눌러 끌면 창 이동). 'PD' 제목 글자는 표시하지 않는다(U17 — 로고만 둔다) -->
      <Border x:Name="TitleArea" Grid.Column="1" Background="Transparent" Width="6" chrome:WindowDecorationProperties.ElementRole="TitleBar"
              DoubleTapped="OnDragAreaDoubleTapped" />

      <Menu x:Name="MainMenu" Grid.Column="2" VerticalAlignment="Center" Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="User" AutomationProperties.AutomationId="shell.menu">
        <!-- 메뉴 AutomationId 규칙: shell.mnu{동작} (UI-08 원격 제어 ui.click 용) -->
        <menus:FileMenu />
        <menus:WindowMenu />
        <menus:ViewMenu />
        <menus:SystemMenuItem />
        <!-- 더보기(D-W2): 웹·Android 의 좁은 폭(접힘 402dp 등)에서 제목줄에 다 들어가지 않는 뒤쪽 메뉴를 이 아래로 옮긴다. 다 들어가면 숨김(코드 비하인드 ReflowMenu) -->
        <MenuItem x:Name="MoreMenu" Header="{loc:Tr menu.more}" IsVisible="False" AutomationProperties.AutomationId="shell.mnuMore" />
      </Menu>

      <!-- 끌기 빈칸: 눌러 끌면 창 이동, 더블클릭 최대화·복원(OS 처리). 플랫폼이 입력을 넘겨주면 코드가 같은 동작을 한다 -->
      <Border Grid.Column="3" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar"
              DoubleTapped="OnDragAreaDoubleTapped" AutomationProperties.AutomationId="shell.titleDragArea" />
    </Grid>

    <!-- 제목줄 오른쪽 도구(2026-11-10 순서 개정, 사용자 요청 4번): [테마] [자동][PC형][태블릿형][모바일형] 다음에 캡션 버튼. 웹·Android 는 캡션 버튼이 숨겨져 UI 형 칸이 오른쪽 끝이고, 폰(UI 형 숨김)은 테마 아이콘이 끝이다 -->
    <!-- 위 여백 2: 도구 묶음 전체를 1px 내려 기호 세로 중심(15)을 캡션 기호(아래 여백 2 로 1px 올림, 중심 15)와 맞춘다(이월 6, AC-203 — 차이 ≤1px) -->
    <StackPanel x:Name="TitleTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2,4,0">
      <!-- 테마 아이콘: 누르면 라이트/다크 전환. 지금 어두우면 해(눌러 밝게), 밝으면 달(눌러 어둡게)을 보인다. UI 형 칸 바로 왼쪽에 간격 4 로 붙는다 -->
      <Button Classes="pdChrome pdOp" Command="{Binding SettingsPanel.ToggleThemeCommand}" chrome:WindowDecorationProperties.ElementRole="User"
              Width="28" Height="24" MinWidth="0" Padding="0" Margin="0,0,4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              ToolTip.Tip="{loc:Tr titlebar.theme.tip}" AutomationProperties.Name="{loc:Tr titlebar.theme.tip}" AutomationProperties.AutomationId="shell.btnTheme">
        <!-- 아래 여백 4: UI 형 스위치 기호(자동 판정 점 자리를 위해 2px 위)와 같은 기준선에 맞춘다(기호 상자 3~17px, 칸 높이 24) -->
        <Panel Margin="0,0,0,4">
          <PathIcon Data="{DynamicResource PdIconThemeSun}" Width="14" Height="14" IsVisible="{Binding SettingsPanel.IsDarkTheme}" />
          <PathIcon Data="{DynamicResource PdIconThemeMoon}" Width="14" Height="14" IsVisible="{Binding !SettingsPanel.IsDarkTheme}" />
        </Panel>
      </Button>

      <!-- UI 형 스위치: 자동·PC형·태블릿형·모바일형 4칸 분할 토글(글자 대신 벡터 아이콘+툴팁). 폰 기기(모바일형 고정)는 숨김, 그 밖 기기(데스크톱 포함)는 보인다.
           표시는 실제 적용 형을 따르고, 누르면 UiSettings.UiStyle 에 명시 저장(UiStyleViewModel.Select) -->
      <StackPanel x:Name="UiModeSwitch" Orientation="Horizontal" VerticalAlignment="Center" Margin="0"
                  IsVisible="{Binding Compact.Style.SelectorVisible}" chrome:WindowDecorationProperties.ElementRole="User"
                  AutomationProperties.AutomationId="shell.uiStyleSwitch">
        <!-- 칸은 Button + 선택 클래스 pdUiOn(적용 모드에서만 나옴). ToggleButton 은 선택된 칸을 다시 누르면 스스로 해제돼(i1402·i1432 항목 4) 쓰지 않는다 -->
        <StackPanel.Styles>
          <!-- UI 형 스위치 4단계(바탕 채움·테두리 없음, 기호 불투명도·색으로만 구분):
               선택(pdUiOn)=강조색 기호 PdBrushChromeGlyphCheckedOnAccent + 1.15배 / 자동 판정 칸(pdUiAuto)=쉬는 기호색 불투명도 1.0 /
               나머지=PdChromeToggleOffOpacity / 기기가 허용하지 않는 칸(disabled)=PdChromeDisabledOpacity. hover=메뉴 막대와 같은 바탕만(테두리 없음, Fluent 기본 hover 테두리도 투명으로 막는다).
               대비(제목줄 바탕 PdBrushMainTitleBar 기준, 내장 테마 7종): 켜짐 기호 3.48~5.49:1(고대비 테마 제외), 꺼짐(0.85 합성) 3.75~11.39:1 — 모두 ≥ 3:1 (odev-11 재계산표).
               칸 바탕은 Button 자체의 Background 를 투명으로 둔다. Fluent 템플릿의 ContentPresenter Background 는 TemplateBinding(템플릿 우선순위)이라
               조건 없는 '/template/ ContentPresenter' 세터가 이기지 못하고 Fluent 기본 바탕(라이트 #FDFDFD)이 칠해졌다(otest-1 AC-023). hover·누름 세터는 조건부라 우선한다 -->
          <Style Selector="Button">
            <Setter Property="Opacity" Value="{DynamicResource PdChromeToggleOffOpacity}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" />
          </Style>
          <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" />
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="1" />
          </Style>
          <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PdBrushMdiTitleButtonHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" />
          </Style>
          <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="{DynamicResource PdChromeDisabledOpacity}" />
          </Style>
          <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PdBrushMainTitleText}" />
          </Style>
          <!-- 자동 켜짐일 때 지금 판정된 칸: 불투명도 1.0 의 쉬는 기호색(선택 칸보다 약하고 꺼짐 칸보다 강하다). 기기가 허용하지 않아도 판정 칸이면 1.0 -->
          <Style Selector="Button.pdUiAuto, Button.pdUiAuto:disabled">
            <Setter Property="Opacity" Value="1" />
          </Style>
          <!-- 자동 판정 칸 점(웹·데스크톱 시험 지적 — 1.0 과 꺼짐 0.85 의 차이만으로는 약하다): 기호 아래 작은 점(PdUiAutoDotSize, 0 이면 숨김). 색은 기호와 같은 제목줄 글자색.
               배치(칸 높이 24 기준, 역라우팅 3차): 4칸 기호 모두 아래 여백 4 를 주어 기호+점 묶음(높이 18)을 가운데 둔다 → 묶음 3~21, 기호 3~17(실제 획 끝 ≤ 16.1),
               점 18~21(지름 3), 포커스 링 안쪽 가장자리 22. 점↔링 1px, 점↔기호 ≥ 1.9px. 기호는 테마 아이콘보다 2px 위에 놓인다 -->
          <Style Selector="Button PathIcon">
            <Setter Property="Margin" Value="0,0,0,4" />
          </Style>
          <Style Selector="Button Ellipse.pdUiAutoDot">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="Button.pdUiAuto Ellipse.pdUiAutoDot">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <!-- 선택 칸: 강조색 기호 + 1.15배(색 외 모양 단서). 바탕·테두리 없음 -->
          <Style Selector="Button.pdUiOn, Button.pdUiOn:pointerover, Button.pdUiOn:pressed, Button.pdUiOn:disabled">
            <Setter Property="Opacity" Value="1" />
          </Style>
          <Style Selector="Button.pdUiOn /template/ ContentPresenter#PART_ContentPresenter, Button.pdUiOn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pdUiOn:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pdUiOn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource PdBrushChromeGlyphCheckedOnAccent}" />
            <Setter Property="RenderTransform" Value="scale(1.15)" />
          </Style>
        </StackPanel.Styles>
        <!-- [자동] 칸: 켜면 창 폭에 따라 자동 전환한다. 다시 누르면 지금 형이 수동 선택으로 남는다. 아래 3칸은 자동일 때도 눌리고, 누르면 자동이 풀리며 그 형으로 바뀐다(비활성은 기기가 허용하지 않을 때뿐) -->
        <Button Classes.pdUiOn="{Binding Compact.Style.SwitchAuto}"
                Command="{Binding Compact.Style.SelectCommand}" CommandParameter="AutoToggle"
                Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4,0,0,4"
                ToolTip.Tip="{loc:Tr titlebar.uiStyle.auto.icon.tip}" AutomationProperties.Name="{loc:Tr titlebar.uiStyle.auto.icon.tip}" AutomationProperties.AutomationId="shell.swUiStyleAuto">
          <PathIcon Data="{DynamicResource PdIconUiAuto}" Width="14" Height="14" />
        </Button>
        <Button Classes.pdUiOn="{Binding Compact.Style.SwitchPc}" Classes.pdUiAuto="{Binding Compact.Style.AutoPc}"
                IsEnabled="{Binding Compact.Style.IsPcEnabled}"
                Command="{Binding Compact.Style.SelectCommand}" CommandParameter="Pc"
                Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="0"
                ToolTip.Tip="{loc:Tr titlebar.uiStyle.pc.icon.tip}" AutomationProperties.Name="{loc:Tr titlebar.uiStyle.pc.icon.tip}" AutomationProperties.AutomationId="shell.swUiStylePc">
          <Panel>
            <PathIcon Data="{DynamicResource PdIconUiPc}" Width="14" Height="14" />
            <Ellipse Classes="pdUiAutoDot" Width="{DynamicResource PdUiAutoDotSize}" Height="{DynamicResource PdUiAutoDotSize}" Fill="{DynamicResource PdBrushMainTitleText}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0" IsHitTestVisible="False" />
          </Panel>
        </Button>
        <Button Classes.pdUiOn="{Binding Compact.Style.SwitchTablet}" Classes.pdUiAuto="{Binding Compact.Style.AutoTablet}"
                IsEnabled="{Binding Compact.Style.IsTabletEnabled}"
                Command="{Binding Compact.Style.SelectCommand}" CommandParameter="Tablet"
                Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="0"
                ToolTip.Tip="{loc:Tr titlebar.uiStyle.tablet.icon.tip}" AutomationProperties.Name="{loc:Tr titlebar.uiStyle.tablet.icon.tip}" AutomationProperties.AutomationId="shell.swUiStyleTablet">
          <Panel>
            <PathIcon Data="{DynamicResource PdIconUiTablet}" Width="14" Height="14" />
            <Ellipse Classes="pdUiAutoDot" Width="{DynamicResource PdUiAutoDotSize}" Height="{DynamicResource PdUiAutoDotSize}" Fill="{DynamicResource PdBrushMainTitleText}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0" IsHitTestVisible="False" />
          </Panel>
        </Button>
        <Button Classes.pdUiOn="{Binding Compact.Style.SwitchMobile}" Classes.pdUiAuto="{Binding Compact.Style.AutoMobile}"
                IsEnabled="{Binding Compact.Style.IsMobileEnabled}"
                Command="{Binding Compact.Style.SelectCommand}" CommandParameter="Mobile"
                Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="0,4,4,0"
                ToolTip.Tip="{loc:Tr titlebar.uiStyle.mobile.icon.tip}" AutomationProperties.Name="{loc:Tr titlebar.uiStyle.mobile.icon.tip}" AutomationProperties.AutomationId="shell.swUiStyleMobile">
          <Panel>
            <PathIcon Data="{DynamicResource PdIconUiMobile}" Width="14" Height="14" />
            <Ellipse Classes="pdUiAutoDot" Width="{DynamicResource PdUiAutoDotSize}" Height="{DynamicResource PdUiAutoDotSize}" Fill="{DynamicResource PdBrushMainTitleText}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0" IsHitTestVisible="False" />
          </Panel>
        </Button>
      </StackPanel>
    </StackPanel>

      <!-- 캡션 버튼: 데스크톱에서 OS 제목줄을 확장했을 때만 보인다(웹·Android·OS 제목줄 사용 시 숨김) -->
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" IsVisible="False">
        <Button Classes="pdChrome pdOp" Click="OnMinimize" chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                ToolTip.Tip="{loc:Tr titlebar.minimize}" AutomationProperties.AutomationId="shell.btnMinimize">
          <PathIcon Data="{DynamicResource DockIconMinimizeGeometry}" />
        </Button>
        <Button x:Name="MaxButton" Classes="pdChrome pdOp" Click="OnMaximizeToggle" chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                AutomationProperties.AutomationId="shell.btnMaximize" snap:SnapFlyoutHover.Enabled="True">
          <PathIcon x:Name="MaxIcon" Data="{DynamicResource DockIconMaximizeGeometry}" />
        </Button>
        <Button Classes="pdChrome pdOp pdClose" Click="OnClose" chrome:WindowDecorationProperties.ElementRole="CloseButton"
                ToolTip.Tip="{loc:Tr titlebar.close}" AutomationProperties.AutomationId="shell.btnClose">
          <PathIcon Data="{DynamicResource DockToolIconCloseGeometry}" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
