<!-- 화면 조립 층 라이브러리(axaml·코드비하인드·테마·문서 뷰) — 셸을 참조하고 호스트가 이 층을 참조한다. 셸은 이 층을 모른다(IViewRegistry). 계층 규칙은 tools/check_layers.py 가 강제한다 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>xkxk.frameworks.ui.views</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\xkxk.frameworks.ui.shell\xkxk.frameworks.ui.shell.csproj" />
  </ItemGroup>

  <!-- DataGrid 테마: 그리드 구현별 파일 하나만 같은 avares 경로(Themes/DataGridTheme.axaml)로 링크한다(odev-gc). SDK 기본 glob 이 두 파일을 다 넣으므로 먼저 뺀다.
       PocGrid 미지정(본판·제품·진단 기본)은 Directory.Build.props 에서 Builtin 이 되므로 Builtin 파일이 링크된다. -->
  <ItemGroup>
    <AvaloniaXaml Remove="Themes\DataGridTheme.*.axaml" />
    <AvaloniaXaml Include="Themes\DataGridTheme.Builtin.axaml" Link="Themes\DataGridTheme.axaml" Condition="'$(PocGrid)' != 'Pro'" />
    <AvaloniaXaml Include="Themes\DataGridTheme.Pro.axaml" Link="Themes\DataGridTheme.axaml" Condition="'$(PocGrid)' == 'Pro'" />
  </ItemGroup>

  <!-- 제목줄 컬러 로고 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Logo\*.png" />
  </ItemGroup>

</Project>
