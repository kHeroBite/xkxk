<!-- 캡션 3버튼(최소·최대·닫기, 클래스 pdCap) 공통 스타일 — 크기·모양·색·기호가 모두 별칭(Docking/CaptionLayout.cs)이라 Windows(오른쪽 넓은 버튼)와 macOS(왼쪽 신호등)를 같은 스타일로 그린다.
     MDI 문서 창(MdiDocumentWindowTheme.axaml 템플릿 Grid#PdCaptionOps)과 SDI 제목줄(SdiTitleBar.axaml)이 쓴다. 메인 제목줄 버튼은 pdCap 이 아니라 영향 없음. MdiChrome.axaml 이 맨 끝에 포함한다(뒤에 와야 pdChrome 기본 스타일을 이긴다) -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dock.Avalonia.Controls">
  <!-- 크기·모양: Windows 36×32(U11, Mars 18×22) / macOS 원 12px + 좌우 4px -->
  <Style Selector="Button.pdChrome.pdOp.pdCap">
    <Setter Property="Width" Value="{DynamicResource PdCapWidth}" />
    <Setter Property="Height" Value="{DynamicResource PdCapHeight}" />
    <Setter Property="Margin" Value="{DynamicResource PdCapMargin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource PdCapCorner}" />
    <Setter Property="Foreground" Value="{DynamicResource PdCapGlyph}" />
  </Style>

  <!-- 기호: 크기·색. macOS 는 쉬는 상태에서 숨기고(투명도 0) 3버튼 묶음에 포인터가 오면 보인다 -->
  <Style Selector="Button.pdCap Path, Button.pdCap PathIcon">
    <Setter Property="Width" Value="{DynamicResource PdCapGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource PdCapGlyphSize}" />
    <Setter Property="Opacity" Value="{DynamicResource PdCapGlyphRestOpacity}" />
  </Style>
  <Style Selector="Button.pdCap Path"><Setter Property="Fill" Value="{DynamicResource PdCapGlyph}" /></Style>
  <Style Selector="Grid.pdCapOps:pointerover Button.pdCap Path, Grid.pdCapOps:pointerover Button.pdCap PathIcon">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- 바탕(쉼): Windows 투명 / macOS 빨강·노랑·초록 원 -->
  <Style Selector="Button.pdCap.pdCapMin /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapMinRest}" /></Style>
  <Style Selector="Button.pdCap.pdCapMax /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapMaxRest}" /></Style>
  <Style Selector="Button.pdCap.pdClose /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapCloseRest}" /></Style>

  <!-- 비활성 창: Windows 는 묶음 흐림(PdCapOpsInactiveOpacity = 기존 흐림값), macOS 는 흐리지 않고 회색 원(HIG: inactive 창은 gray) -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PdCaptionOps">
    <Setter Property="Opacity" Value="{DynamicResource PdCapOpsInactiveOpacity}" />
  </Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Button.pdCap /template/ ContentPresenter#PART_ContentPresenter, Border.pdSdiFrame:not(.active) Button.pdCap /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PdCapInactiveRest}" />
  </Style>

  <!-- 테두리: 늘 같은 두께(별칭, macOS 0)로 두고 평소 투명, hover 때만 색을 넣는다. 닫기도 같다 — 빨강이 제목줄 색과 비슷한 테마(pd-ember)에서 채움만으로는 구분되지 않는다 -->
  <Style Selector="Button.pdCap /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="{DynamicResource PdCapBorderThickness}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.pdCap:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource PdCapHoverBorder}" /></Style>
  <!-- hover·누름 바탕(비활성 회색보다 뒤 — macOS 도 비활성 창 신호등에 포인터를 올리면 색이 돌아온다). Windows·Mars 는 채움(CaptionLayout 별칭, 표는 공통원칙 §4.2) -->
  <Style Selector="Button.pdCap.pdCapMin:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapMinHover}" /></Style>
  <Style Selector="Button.pdCap.pdCapMax:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapMaxHover}" /></Style>
  <Style Selector="Button.pdCap.pdClose:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapCloseHover}" /></Style>
  <Style Selector="Button.pdCap.pdCapMin:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapMinPressed}" /></Style>
  <Style Selector="Button.pdCap.pdCapMax:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapMaxPressed}" /></Style>
  <Style Selector="Button.pdCap.pdClose:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapClosePressed}" /></Style>
  <!-- MDI 닫기 누름 별칭을 따로 둔다(macOS 값이 다를 수 있다). 위 줄 뒤에 둬야 MDI 에서 이긴다 -->
  <Style Selector="controls|MdiDocumentWindow /template/ Button.pdCap.pdClose:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PdCapClosePressedMdi}" /></Style>

  <!-- 기호 색: Windows·Mars 는 hover 때 평소 색을 유지하고(채움이 상태를 보인다) 누름만 기호 색이 바뀐다(F3 = 누름 기호색 ≠ hover 기호색). macOS 는 별칭이 신호등 기호색 그대로다 -->
  <Style Selector="Button.pdCap:pointerover"><Setter Property="Foreground" Value="{DynamicResource PdCapGlyphHover}" /></Style>
  <Style Selector="Button.pdCap:pointerover Path"><Setter Property="Fill" Value="{DynamicResource PdCapGlyphHover}" /></Style>
  <Style Selector="Button.pdCap:pressed"><Setter Property="Foreground" Value="{DynamicResource PdCapGlyphPressed}" /></Style>
  <Style Selector="Button.pdCap:pressed Path"><Setter Property="Fill" Value="{DynamicResource PdCapGlyphPressed}" /></Style>

  <!-- 닫기 hover 기호: Windows 빨강 채움 위 밝은 기호(메인 창과 같은 위험 색 관례) / macOS 어두운 기호 -->
  <Style Selector="Button.pdCap.pdClose:pointerover"><Setter Property="Foreground" Value="{DynamicResource PdCapCloseGlyphHover}" /></Style>
  <Style Selector="Button.pdCap.pdClose:pointerover Path"><Setter Property="Fill" Value="{DynamicResource PdCapCloseGlyphHover}" /></Style>
  <!-- 닫기 누름 기호: 메인 창과 같은 토큰 / macOS 는 hover 와 같은 기호 — hover 뒤에 둬야 누름이 이긴다 -->
  <Style Selector="Button.pdCap.pdClose:pressed"><Setter Property="Foreground" Value="{DynamicResource PdCapCloseGlyphPressed}" /></Style>
  <Style Selector="Button.pdCap.pdClose:pressed Path"><Setter Property="Fill" Value="{DynamicResource PdCapCloseGlyphPressed}" /></Style>
</Styles>
