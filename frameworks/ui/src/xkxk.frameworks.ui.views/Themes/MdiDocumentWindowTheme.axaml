<!-- MDI 문서 창 테마(UI-09·UI-10) — Dock 12.1.0.12 MdiDocumentWindow 재정의: 제목줄(로고·제목·기능 버튼·캡션 3버튼)·외곽(모서리·hairline·그림자)·크기 손잡이. 스타일 차이는 리소스 별칭(WindowCommands·CaptionLayout). MdiChrome.axaml 이 병합 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Dock.Avalonia.Controls"
                    xmlns:conv="using:Dock.Avalonia.Converters"
                    xmlns:core="using:Dock.Model.Core"
                    xmlns:dmc="using:Dock.Model.Controls"
                    xmlns:views="using:xkxk.frameworks.ui.views" xmlns:views2m="using:xkxk.frameworks.ui.views" xmlns:views1m="using:xkxk.frameworks.ui.Controls"
                    xmlns:loc="using:xkxk.frameworks.ui.shell.Localization"
                    xmlns:tabjoin="using:xkxk.frameworks.ui.shell.Docking"
                    xmlns:snap="using:xkxk.frameworks.ui.views.Snap">
  <!-- MDI 문서 창: Dock 12.1.0.12 원본 PART 유지·제목줄/외곽 교체. 관리형 도구 창은 원본 버튼(메뉴·핀=PinDockable·닫기) 유지. .locked=크기 손잡이 숨김(끌기는 ChromeButtons) -->
  <ControlTheme x:Key="{x:Type controls:MdiDocumentWindow}" TargetType="controls:MdiDocumentWindow" x:DataType="core:IDockable">
    <!-- OneWay 필수: IsDragEnabled 는 기본 TwoWay 라 ChromeButtons 가 위치 고정 때 넣는 로컬 false 가 문서 CanDrag 로 역기록돼 해제(ClearValue) 뒤에도 끌기가 막혔다(conv_179444169058 실측) -->
    <Setter Property="(DockProperties.IsDragEnabled)" Value="{Binding CanDrag, Mode=OneWay}" />
    <Setter Property="(DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(DockProperties.DockGroup)" Value="{Binding DockGroup}" />
    <Setter Property="DocumentContextMenu" Value="{DynamicResource MdiDocumentWindowContextMenu}" />
    <Setter Property="Background" Value="{DynamicResource PdBrushSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PdChromeBorderInactive}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- Avalonia 12.1.4 TemplatedControl 은 ClipToBounds 기본값이 true 라 창 밖 그림자(PART_OuterBorder BoxShadow)가 잘려 0px 였다(odev-fix 원격 확인) -->
    <Setter Property="ClipToBounds" Value="False" />
    <!-- 이동 감시(위치가 바뀌는 동안 .pdMoving·합성기 틱 유지) — xkxk.frameworks.ui.views/MdiMoveLightener.cs -->
    <Setter Property="(views:MdiMoveLightener.Track)" Value="True" />
    <!-- 창 탭 합류(01 §4.4): 제목줄 끌기를 엿보는 처리기 설치 — xkxk.frameworks.ui.shell/Docking/MdiTabJoinDrag.cs -->
    <Setter Property="(tabjoin:MdiTabJoinDrag.Enabled)" Value="True" />
    <!-- 창 배치(스냅, 11 문서 §5): 탭 합류 처리기 다음에 설치해 같은 이동에서 표적 판정이 먼저 갱신되게 한다 — xkxk.frameworks.ui.shell/Docking/MdiSnapDrag.cs -->
    <Setter Property="(tabjoin:MdiSnapDrag.Enabled)" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockableControl TrackingMode="Visible">
          <!-- 바깥 층: 둥근 모서리·1px hairline·그림자(밖으로 그려지므로 잘라내지 않는다). 안쪽 층: 같은 모서리로 내용 잘라냄(ClipToBounds)·Mars 여백 띠 -->
          <Border x:Name="PART_OuterBorder" CornerRadius="{DynamicResource PdChromeCorner}"
                  BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
           <views1m:ClipBorder x:Name="PdClip" CornerRadius="{DynamicResource PdChromeInnerCorner}" ClipToBounds="True" Padding="{DynamicResource PdChromeFramePadding}"
                             BorderThickness="{DynamicResource PdChromeHighlightThickness}" BorderBrush="{DynamicResource PdBrushWindowHighlight}">
            <Grid>
              <DockPanel>
                <Border x:Name="PART_Header" DockPanel.Dock="Top" Height="{DynamicResource PdMdiTitleHeight}"
                        ContextMenu="{TemplateBinding DocumentContextMenu}" TextElement.Foreground="{DynamicResource PdChromeTitleText}">
                  <!-- Dock HeaderPressedHandler 는 PART_DragHandle 안 누름이면 MDI 이동을 하지 않는다(원본 387행) → DragHandle 은 4px(도킹 끌기용),
                       제목 영역(PART_Grid)을 끌면 창 이동·더블클릭 최대화(Win11 '빈 곳 끌기' 동작) -->
                  <!-- 캡션 3버튼은 머리줄 끝에 겹쳐 고정하고(정렬 = CaptionLayout 별칭: Windows 오른쪽·macOS 왼쪽), 나머지 줄은 그 폭만큼 비운 뒤 잘라낸다.
                       MDI 창은 폭 제한 없이 측정된 뒤 좁게 배치되어 Grid 의 * 칸이 줄지 않았다(웹 c2dev_j 228px 실측: 캡션이 창 밖) — 배치 단계에서 자리를 보장한다 -->
                  <Panel>
                  <!-- Canvas 는 희망 폭 0 을 알려 머리줄이 창 폭을 키우지 않게 한다(c2dev_k 실측: 머리줄 희망 폭 약 450 으로 배치·잘림 → 오른쪽 끝 캡션이 잘린 쪽).
                       안쪽 Grid 폭은 Canvas 실제 폭에 묶어 넓은 창에서는 예전처럼 늘고, 좁은 창에서는 * 칸(제목·기능 버튼)부터 줄어든다 -->
                  <Canvas ClipToBounds="True" Margin="{DynamicResource PdCaptionReserve}">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Width="{Binding $parent[Canvas].Bounds.Width}" Height="{Binding $parent[Canvas].Bounds.Height}"><!-- 0 (예비)|1 로고|2 끌기|3 제목+기능 버튼|4 (예비) -->
                    <!-- U12: MDI 자식 창은 앱 로고가 아니라 문서 기호(Win32 MDI 자식 창의 창 메뉴 아이콘 관행, 05_창크롬 문서 §2.7). 클릭 = 창 메뉴는 그대로.
                         앱 로고는 SDI 만 — 웹·Android 의 SDI(관리형 창)는 이 템플릿을 쓰므로 ChromeButtons 가 거는 .pdSdi 로 로고를 바꾼다 -->
                    <views2m:ChromeLogo x:Name="PdLogo" Grid.Column="1" Classes="pdChrome pdLogo" IsVisible="{DynamicResource PdLogoVisible}" AutomationProperties.AutomationId="chrome.logo" ToolTip.Tip="{loc:Tr chrome.tip.logo}">
                      <Panel>
                        <!-- 창 아이콘(22 §2.3, 23 §3): 문서가 있으면 화면 아이콘·스피너, 없으면 문서 기호. 관리형 SDI 는 이 칸에 앱 로고를 두고 창 아이콘은 제목 앞(PdSdiTitleIcon) -->
                        <views2m:WindowIcon x:Name="PdDocIcon" Document="{Binding Converter={x:Static views2m:WindowIcon.ToDocument}}"
                                            Width="{DynamicResource PdLogoIconSize}" Height="{DynamicResource PdLogoIconSize}" />
                        <Image x:Name="PdAppLogo" IsVisible="False" Source="avares://xkxk.frameworks.ui.views/Assets/Logo/pd-logo-64.png" Width="{DynamicResource PdLogoIconSize}" Height="{DynamicResource PdLogoIconSize}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                      </Panel>
                    </views2m:ChromeLogo>
                    <Border x:Name="PART_DragHandle" Grid.Column="2" Width="4" DockProperties.IsDragArea="True" Background="Transparent" />
                    <!-- 제목 + 기능 버튼 칸(리드 결정 #7, SDI 와 같은 규칙): 캡션 3버튼과 제목 최소 칸(PdTitleMinReserve = WindowMinSize 의 제목 항 "W…"+8)은 항상 지키고,
                         폭이 모자라면 기능 버튼부터 잘린다 — 기능 버튼 줄은 제목 최소 칸 오른쪽 자리에만 놓이고(잘라냄), 제목 글자를 덮을 때는 머리줄 바탕으로 가린다.
                         그래서 최소 폭에서도 제목 자리를 더블클릭하면 기능 버튼이 아니라 제목 영역(최대화)이 받는다 -->
                    <Panel Grid.Column="3" ClipToBounds="True">
                    <!-- D-C2-23: 제목은 기능 버튼 줄이 실제로 차지한 폭(PdCaptionStripHost)을 뺀 칸 안에서 말줄임한다(글자 중간 잘림·버튼 밑 겹침 방지).
                         버튼 줄은 제목 최소 칸 오른쪽에만 놓이므로 제목 칸은 최소 칸 아래로 줄지 않는다(결정 ⓐ 유지). 가로 StackPanel 은 폭을 무한으로 재 말줄임이 걸리지 않아 DockPanel 로 바꿨다 -->
                    <Grid x:Name="PART_Grid" Background="Transparent" Margin="2,0,0,0" ClipToBounds="True" ColumnDefinitions="*,Auto">
                      <Border Grid.Column="1" Width="{Binding #PdCaptionStripHost.Bounds.Width}" />
                      <Panel x:Name="PART_DocumentHeader" VerticalAlignment="Center" HorizontalAlignment="{DynamicResource PdTitleAlignment}"
                             IsVisible="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableIsToolWindowConverter.Instance}, ConverterParameter=Not, FallbackValue=True}">
                        <DockPanel HorizontalAlignment="Left">
                          <Panel DockPanel.Dock="Left" IsHitTestVisible="False" IsVisible="{DynamicResource PdLogoVisible}">
                            <views2m:WindowIcon x:Name="PdSdiTitleIcon" Document="{Binding Converter={x:Static views2m:WindowIcon.ToDocument}}"
                                                Classes.pdHasDoc="{Binding Converter={x:Static views2m:WindowIcon.HasDocument}}"
                                                Width="{DynamicResource PdLogoIconSize}" Height="{DynamicResource PdLogoIconSize}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          </Panel>
                          <TextBlock Text="*" DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsModified}" />
                          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                      </Panel>
                      <DockPanel x:Name="PART_ToolHeader" x:DataType="dmc:IToolDock"
                                 DataContext="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableToolDockConverter.Instance}}"
                                 IsVisible="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableIsToolWindowConverter.Instance}, FallbackValue=False}">
                        <!-- H-15: 활성 문서가 없는 빈 패널에서 ActiveDockable.Title 두 단 경로가 null 을 지나 Binding 오류를 내지 않도록 DataContext 를 한 단(ActiveDockable)씩 나눠 받는다(null DataContext 는 오류 없이 FallbackValue) -->
                        <TextBlock DataContext="{Binding ActiveDockable}"
                                   Text="{Binding Title, x:DataType=core:IDockable, FallbackValue=TITLE, TargetNullValue=TITLE}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Grid>
                    <!-- 관리형 SDI 는 제목 앞 창 아이콘(22 §2.3) 폭만큼 기능 버튼 줄을 더 오른쪽에서 시작한다 — 좁으면 제목보다 기능 버튼부터 잘린다 -->
                    <DockPanel>
                    <Panel DockPanel.Dock="Left" IsHitTestVisible="False" IsVisible="{DynamicResource PdLogoVisible}">
                      <Border x:Name="PdSdiIconInset" Classes.pdHasDoc="{Binding Converter={x:Static views2m:WindowIcon.HasDocument}}"
                              Width="{DynamicResource PdLogoIconSize}" Margin="0,0,6,0" />
                    </Panel>
                    <Border Margin="{DynamicResource PdTitleMinReserve}" ClipToBounds="True">
                      <Border x:Name="PdCaptionStripHost" HorizontalAlignment="Right" Background="{Binding #PART_Header.Background}"
                              IsVisible="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableIsToolWindowConverter.Instance}, ConverterParameter=Not, FallbackValue=True}">
                        <StackPanel x:Name="PdCaptionStrip" Orientation="Horizontal" VerticalAlignment="Center">
                          <views2m:ChromeButtons />
                        </StackPanel>
                      </Border>
                    </Border>
                    </DockPanel>
                    </Panel>
                  </Grid>
                  <!-- 창 탭 합류 표적(01 §4.4 규칙 2): 다른 MDI 창을 끄는 동안(.pdTabJoinArmed)만 보이는 20×20 '탭으로 합치기' 아이콘. Canvas 겹침이라 제목 글자를 밀지 않는다.
                       자리(PdTabJoinSlot)는 늘 배치돼 MdiTabJoinDrag 가 숨은 아이콘의 표적 사각형을 이 자리 가운데로 계산한다(표식 클래스 pdTabJoinIcon).
                       자리는 로고 칸(PdLogo) 경계에 묶어 두 아이콘 중심을 맞춘다(2026-11-11 — 예전 Left 4·폭 24 는 로고 칸 48 의 중심과 8 어긋났다). 로고 칸이 없으면(macOS) 왼쪽 24 칸(MinWidth) -->
                  <Panel x:Name="PdTabJoinSlot" Canvas.Left="{Binding #PdLogo.Bounds.X}" Width="{Binding #PdLogo.Bounds.Width}" MinWidth="24" Height="{Binding $parent[Canvas].Bounds.Height}" IsHitTestVisible="False">
                    <Border x:Name="PART_TabJoinIcon" Classes="pdTabJoinIcon" Width="20" Height="20" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="4" BorderThickness="1" AutomationProperties.AutomationId="chrome.tabJoin" ToolTip.Tip="{loc:Tr chrome.tabJoin.tip}">
                      <PathIcon Data="{DynamicResource PdIconTabJoin}" Width="14" Height="14" />
                    </Border>
                  </Panel>
                  </Canvas>
                    <Grid x:Name="PdCaptionOps" HorizontalAlignment="{DynamicResource PdCaptionAlign}" Classes="pdCapOps" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" Margin="{DynamicResource PdCaptionOpsMargin}"
                          IsVisible="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableIsToolWindowConverter.Instance}, ConverterParameter=Not, FallbackValue=True}">
                      <Button x:Name="PART_MinimizeButton" Grid.Column="{DynamicResource PdCapMinColumn}" Classes="pdChrome pdOp pdCap pdCapMin" AutomationProperties.AutomationId="chrome.btnMin" ToolTip.Tip="{loc:Tr chrome.tip.minimize}">
                        <Path x:Name="PART_MinimizePath" />
                      </Button>
                      <Button x:Name="PART_MaximizeRestoreButton" Grid.Column="{DynamicResource PdCapMaxColumn}" Classes="pdChrome pdOp pdCap pdCapMax" AutomationProperties.AutomationId="chrome.btnMax" ToolTip.Tip="{loc:Tr chrome.tip.maxRestore}" snap:SnapFlyoutHover.Enabled="True">
                        <Path x:Name="PART_MaximizeRestorePath" />
                      </Button>
                      <Button x:Name="PART_CloseButton" Grid.Column="{DynamicResource PdCapCloseColumn}" Classes="pdChrome pdOp pdCap pdClose" AutomationProperties.AutomationId="chrome.btnClose" ToolTip.Tip="{loc:Tr common.close}"
                              Command="{Binding Owner.Factory.CloseDockable}" CommandParameter="{Binding}">
                        <Path x:Name="PART_ClosePath" Data="{DynamicResource PdCapCloseGeometry}" />
                      </Button>
                    </Grid>
                    <!-- 도구 창 버튼(캡션과 동시에 보이지 않음)도 같은 자리(오른쪽 끝)에 고정 -->
                    <StackPanel x:Name="PART_ToolButtons" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" x:DataType="dmc:IToolDock"
                                DataContext="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableToolDockConverter.Instance}}"
                                IsVisible="{Binding $parent[controls:MdiDocumentWindow].DataContext, Converter={x:Static conv:ManagedDockableIsToolWindowConverter.Instance}, FallbackValue=False}">
                      <Button x:Name="PART_ToolMenuButton" Classes="pdChrome pdOp" Flyout="{DynamicResource ToolChromeControlContextMenu}">
                        <Path x:Name="PART_ToolMenuPath" Data="{DynamicResource DockIconMenuGeometry}" />
                      </Button>
                      <Button x:Name="PART_ToolPinButton" Classes="pdChrome pdOp" ToolTip.Tip="{loc:Tr chrome.tip.toolPin}" IsVisible="{Binding ActiveDockable.CanPin, FallbackValue=False}"
                              Command="{Binding Owner.Factory.PinDockable}" CommandParameter="{Binding ActiveDockable}">
                        <Path x:Name="PART_ToolPinPath" Data="{DynamicResource DockIconPinGeometry}"
                              Classes.pinned="{Binding ActiveDockable.OriginalOwner, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </Button>
                      <Button x:Name="PART_ToolCloseButton" Classes="pdChrome pdOp pdClose" Command="{Binding Owner.Factory.CloseDockable}" CommandParameter="{Binding ActiveDockable}">
                        <Path x:Name="PART_ToolClosePath" Data="{DynamicResource DockToolIconCloseGeometry}" />
                      </Button>
                    </StackPanel>
                  </Panel>
                </Border>
                <!-- C3: Windows 본문 반경 0 — 아래 모서리는 PdClip(반경 7)이 잘라 곡선 1개. macOS 9·클래식 0(PdChromeContentCorner) -->
                <views1m:ClipBorder x:Name="PART_ContentBorder" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PdChromeContentCorner}">
                  <DeferredContentControl x:Name="PART_ContentPresenter" Content="{Binding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <DeferredContentControl.ContentTemplate>
                      <!-- A10: 다른 창에서 문서 뷰를 꺼내 올 때 옛 창 레이아웃 대기열을 먼저 비운다 — xkxk.frameworks.ui.views/RootSafeRecyclingDataTemplate.cs -->
                      <views:RootSafeRecyclingDataTemplate Parent="{Binding #PART_ContentPresenter}" />
                    </DeferredContentControl.ContentTemplate>
                  </DeferredContentControl>
                </views1m:ClipBorder>
              </DockPanel>
              <Panel x:Name="PdResizeGrips" AutomationProperties.AutomationId="chrome.gripResize">
                <Border x:Name="PART_ResizeTop" Height="{DynamicResource DockMdiResizeEdgeThickness}" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" />
                <Border x:Name="PART_ResizeBottom" Height="{DynamicResource DockMdiResizeEdgeThickness}" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" />
                <Border x:Name="PART_ResizeLeft" Width="{DynamicResource DockMdiResizeEdgeThickness}" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" />
                <Border x:Name="PART_ResizeRight" Width="{DynamicResource DockMdiResizeEdgeThickness}" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
                <Border x:Name="PART_ResizeTopLeft" Width="{DynamicResource DockMdiResizeCornerSize}" Height="{DynamicResource DockMdiResizeCornerSize}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" />
                <Border x:Name="PART_ResizeTopRight" Width="{DynamicResource DockMdiResizeCornerSize}" Height="{DynamicResource DockMdiResizeCornerSize}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" />
                <Border x:Name="PART_ResizeBottomLeft" Width="{DynamicResource DockMdiResizeCornerSize}" Height="{DynamicResource DockMdiResizeCornerSize}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" />
                <Border x:Name="PART_ResizeBottomRight" Width="{DynamicResource DockMdiResizeCornerSize}" Height="{DynamicResource DockMdiResizeCornerSize}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" />
              </Panel>
            </Grid>
           </views1m:ClipBorder>
          </Border>
        </DockableControl>
      </ControlTemplate>
    </Setter>

    <!-- 색은 전역 Style 이 아니라 여기서만 정한다(전역 Style 이 ControlTheme·TemplateBinding 보다 우선해 활성 색을 덮었다, 22:51 실측).
         바깥 층 바탕 = 제목줄 색(Mars 클래식의 여백 띠). 그림자는 전 창 2겹: 비활성 얕게·활성 깊게 -->
    <Style Selector="^/template/ Border#PART_OuterBorder">
      <Setter Property="Background" Value="{DynamicResource PdChromeTitleInactive}" />
      <Setter Property="BoxShadow" Value="{DynamicResource PdMdiShadowInactive}" />
    </Style>
    <Style Selector="^/template/ Border#PART_Header"><Setter Property="Background" Value="{DynamicResource PdChromeTitleInactive}" /></Style>
    <Style Selector="^:active"><Setter Property="BorderBrush" Value="{DynamicResource PdChromeBorderActive}" /></Style>
    <Style Selector="^:active /template/ Border#PART_OuterBorder">
      <Setter Property="Background" Value="{DynamicResource PdChromeTitleActive}" />
      <Setter Property="BoxShadow" Value="{DynamicResource PdMdiShadow}" />
    </Style>
    <Style Selector="^:active /template/ Border#PART_Header"><Setter Property="Background" Value="{DynamicResource PdChromeTitleActive}" /></Style>
    <!-- 비활성: 제목줄 요소 전부 반투명(Win11 공식 동작, 투명도는 Win11 실측 캡처 기준 0.45 — 스타일별 리소스) -->
    <Style Selector="^:not(:active) /template/ Grid#PART_Grid, ^:not(:active) /template/ StackPanel#PdCaptionStrip, ^:not(:active) /template/ :is(Button)#PdLogo">
      <Setter Property="Opacity" Value="{DynamicResource PdChromeInactiveOpacity}" />
    </Style>
    <!-- 항상 위: 제목줄·띠 적갈색 + 밝은 글자(Mars 의 항상 위 표시를 스타일 공통으로 유지) -->
    <Style Selector="^.pinned /template/ Border#PART_OuterBorder, ^.pinned /template/ Border#PART_Header">
      <Setter Property="Background" Value="{DynamicResource PdBrushMdiTitleBarPinned}" />
    </Style>
    <Style Selector="^.pinned /template/ Border#PART_Header"><Setter Property="TextElement.Foreground" Value="{DynamicResource PdBrushMdiTitleText}" /></Style>
    <Style Selector="^/template/ Path">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="{DynamicResource PdCaptionGlyphSize}" />
      <Setter Property="Height" Value="{DynamicResource PdCaptionGlyphSize}" />
      <Setter Property="Fill" Value="{DynamicResource PdChromeGlyph}" />
    </Style>
    <!-- 닫기 hover·누름 기호(U6 — 바탕 대신 기호 색). 실제 색은 CaptionButtons·ChromeButtonStyles 전역 규칙이 이긴다(테마 규칙은 기본값) -->
    <Style Selector="^/template/ Button#PART_CloseButton:pointerover Path, ^/template/ Button#PART_ToolCloseButton:pointerover Path">
      <Setter Property="Fill" Value="{DynamicResource PdChromeCloseGlyphHover}" />
    </Style>
    <Style Selector="^/template/ Button#PART_CloseButton:pressed Path"><Setter Property="Fill" Value="{DynamicResource PdCapCloseGlyphPressed}" /></Style>
    <Style Selector="^/template/ Button#PART_ToolCloseButton:pressed Path"><Setter Property="Fill" Value="{DynamicResource PdChromeCloseGlyphPressed}" /></Style>
    <Style Selector="^/template/ Path#PART_ToolPinPath.pinned"><Setter Property="Data" Value="{DynamicResource DockIconPinnedGeometry}" /></Style>
    <Style Selector="^.locked /template/ Panel#PdResizeGrips"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^.pdSdi /template/ views2m|WindowIcon#PdDocIcon"><Setter Property="IsVisible" Value="False" /></Style><!-- U12 관리형 SDI 의 왼쪽 칸은 앱 로고 -->
    <!-- 관리형 SDI 의 창 아이콘은 제목 앞(22 §2.3). MDI 문서 창은 왼쪽 칸 PdDocIcon 만 쓴다 -->
    <Style Selector="^/template/ views2m|WindowIcon#PdSdiTitleIcon"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^.pdSdi /template/ views2m|WindowIcon#PdSdiTitleIcon.pdHasDoc"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^/template/ Border#PdSdiIconInset"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^.pdSdi /template/ Border#PdSdiIconInset.pdHasDoc"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^.pdSdi /template/ Image#PdAppLogo"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^/template/ Path#PART_MinimizePath"><Setter Property="Data" Value="{DynamicResource PdCapMinGeometry}" /></Style>
    <Style Selector="^/template/ Path#PART_MaximizeRestorePath"><Setter Property="Data" Value="{DynamicResource PdCapMaxGeometry}" /></Style>
    <Style Selector="^:maximized /template/ Path#PART_MaximizeRestorePath"><Setter Property="Data" Value="{DynamicResource PdCapRestoreGeometry}" /></Style>
    <Style Selector="^:minimized /template/ Border#PART_ContentBorder"><Setter Property="IsVisible" Value="False" /></Style>
    <!-- 최대화: 모서리 0·테두리 0·그림자 없음(Win11 공식 '최대화·스냅 시 둥글리지 않음') -->
    <Style Selector="^:maximized /template/ Border#PART_OuterBorder">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="^:maximized /template/ :is(Border)#PdClip">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:maximized /template/ :is(Border)#PART_ContentBorder"><Setter Property="CornerRadius" Value="0" /></Style>
    <!-- 이동 중 크롬 경량화(.pdMoving — MdiMoveLightener 가 위치가 바뀌는 동안만 건다, 옵션 MdiMoveLight.Enabled 기본 켬): 그림자는 ui.mdi.move_light.shadow=hide(기본, .pdMoveShadowOff)일 때만 이동용 리소스(기본 없음)로 바꾼다.
         둥근 잘라냄 반경 0(ClipBorder 가 Clip 지오메트리를 없앤다)은 옵션일 때만(.pdMoveSquare, 아래). 이동이 멈추면 클래스가 빠져 위 정지 상태 수치로 바로 돌아간다.
         odebug-perf2 실측: 20창 이동 1회당 렌더 70~82ms 중 그림자 약 29ms·Windows 크롬(둥근 잘라냄 등) 약 25ms. 위 :active 규칙보다 뒤에 둬야 이긴다 -->
    <!-- 2026-11-11 사용자 지시(모서리 일관성): 끌기 중에도 모서리 반경은 정지 상태 그대로다. 반경 0 은 옵션 MdiMoveLight.SquareCorners(기본 끔)일 때만 .pdMoveSquare 로 건다 -->
    <Style Selector="^.pdMoving.pdMoveShadowOff /template/ Border#PART_OuterBorder">
      <Setter Property="BoxShadow" Value="{DynamicResource PdMdiShadowMoving}" />
    </Style>
    <Style Selector="^.pdMoveSquare /template/ Border#PART_OuterBorder"><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="^.pdMoveSquare /template/ :is(Border)#PdClip"><Setter Property="CornerRadius" Value="0" /></Style>
    <!-- 끌기 중 겹친 정지 창 가벼운 크롬(.pdMovingSibling — MdiStaticLight 가 다른 창이 움직이는 동안만 건다, 옵션 MdiMoveLight.Siblings 기본 켬, 01 §4.2 N2): .pdMoving 과 같은 값.
         쉼표 선택자 대신 따로 둔다(중첩 ^ 와 쉼표 조합 동작을 확인하지 않았다) -->
    <Style Selector="^.pdMovingSibling.pdMoveShadowOff /template/ Border#PART_OuterBorder">
      <Setter Property="BoxShadow" Value="{DynamicResource PdMdiShadowMoving}" />
    </Style>
    <!-- 창 탭 합류 표시(01 §4.4 규칙 4, MdiTabJoinDrag 가 클래스를 건다): .pdTabJoinArmed = 아이콘 보임(제목줄 위 반투명 칸),
         .pdTabJoinTarget.pdTabJoinOnIcon = 머무는 아이콘 강조색 칸, .pdTabJoinOnStrip = 탭 줄 표적 창 테두리 강조색 2px,
         .pdTabJoinSource = 표적 위에 있는 동안 끄는 창 반투명(아래 표적이 보이게, 표적을 벗어나면 바로 불투명) -->
    <!-- 합치기 아이콘이 보이는 동안 원래 아이콘(문서 기호·관리형 SDI 앱 로고)은 숨긴다(2026-11-11). IsVisible 이 아니라 불투명도 — 관리형 SDI 표적 판정이 PdAppLogo 의 보임·경계를 쓴다 -->
    <Style Selector="^.pdTabJoinArmed /template/ views2m|WindowIcon#PdDocIcon, ^.pdTabJoinArmed /template/ Image#PdAppLogo">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^.pdTabJoinArmed /template/ Border#PART_TabJoinIcon">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Background" Value="{DynamicResource PdChromeTitleActive}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PdChromeGlyph}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeGlyph}" />
    </Style>
    <Style Selector="^.pdTabJoinTarget.pdTabJoinOnIcon /template/ Border#PART_TabJoinIcon">
      <Setter Property="Background" Value="{DynamicResource PdBrushAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PdChromeGlyphHover}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource PdBrushWhiteGlyph}" />
    </Style>
    <Style Selector="^.pdTabJoinTarget.pdTabJoinOnStrip /template/ Border#PART_OuterBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource PdBrushAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^.pdTabJoinSource"><Setter Property="Opacity" Value="{DynamicResource PdTabJoinSourceOpacity}" /></Style>
  </ControlTheme>
</ResourceDictionary>
