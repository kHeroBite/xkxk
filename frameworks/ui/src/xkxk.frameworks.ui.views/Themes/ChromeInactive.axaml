<!-- 비활성 MDI 창 제목줄 흐림(브러시 방식, Q5 A~D): Inactive 별칭은 Opacity 방식(기본)이면 원래 브러시(겉모습·비용 변화 없음), 브러시 방식이면 같은 알파를 곱한 색.
     브러시 방식일 때만 WindowCommands.ApplyShadow 가 앱 스타일 맨 끝에 붙인다(M1) — MdiChrome.axaml 의 pdChrome 전역 스타일(글리프·켜짐 색·hover·누름·닫기)보다 뒤에 와야 이 줄들이 이긴다 -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dock.Avalonia.Controls"
        x:Class="xkxk.frameworks.ui.views.Themes.ChromeInactiveStyles">
  <!-- 제목 글자·로고(일반 → 항상 위 순서: 고정 창은 적갈색 위 밝은 글자를 흐림) -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PART_Grid, controls|MdiDocumentWindow:not(:active) /template/ :is(Button)#PdLogo">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeTitleTextInactive}" />
  </Style>
  <Style Selector="controls|MdiDocumentWindow.pinned:not(:active) /template/ Grid#PART_Grid, controls|MdiDocumentWindow.pinned:not(:active) /template/ :is(Button)#PdLogo">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PdChromeTitleTextPinnedInactive}" />
  </Style>

  <!-- 캡션 줄 글리프: 기능 버튼(PathIcon 은 버튼 Foreground) + 최소·최대·닫기(템플릿 Path Fill) -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip :is(Button).pdChrome">
    <Setter Property="Foreground" Value="{DynamicResource PdChromeGlyphInactive}" />
  </Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip Path">
    <Setter Property="Fill" Value="{DynamicResource PdChromeGlyphInactive}" />
  </Style>

  <!-- 켜짐 글리프(항상 위·위치 고정) -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip ToggleButton.pdChrome.pinOn">
    <Setter Property="Foreground" Value="{DynamicResource PdChromePinOnInactive}" />
  </Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip ToggleButton.pdChrome.lockOn">
    <Setter Property="Foreground" Value="{DynamicResource PdChromeLockOnInactive}" />
  </Style>

  <!-- 캐시(새로고침) 아이콘: 적중률 색(0% 은색 포함)은 코드가 로컬 값으로 넣어 스타일로 못 바꾼다 → 아이콘 하나만 투명도(Opacity 방식이면 1 = 층 없음).
       0% 를 스타일 색으로 돌리는 안은 활성 창의 은색(Mars 0% 표시)까지 바꾸므로 쓰지 않았다 -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip Button#BtnRefresh PathIcon">
    <Setter Property="Opacity" Value="{DynamicResource PdChromeInactiveGlyphOpacity}" />
  </Style>

  <!-- U6: hover·누름은 바탕 없이 기호 색(Windows 기준 — 브러시 방식은 진단 전용). 기능 버튼은 ContentPresenter Foreground, 캡션 3버튼은 Path Fill.
       순서 hover → 누름 → 닫기(뒤가 이긴다) -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip :is(Button).pdChrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource PdChromeGlyphHoverInactive}" />
  </Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ StackPanel#PdCaptionStrip :is(Button).pdChrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource PdChromeGlyphPressedInactive}" />
  </Style>
  <!-- 비활성 창 호버 바탕(전용 토큰 PdBrushChromeHoverInactive → 별칭 PdChromeHoverInactive, 01 §4.2) 규칙은 Opacity 방식(기본)에서도 먹어야 하므로
       항상 붙는 Themes/ChromeButtonStyles.axaml 에 있다(이 파일은 브러시 방식일 때만 붙는다 — 브러시 방식 진단도 그 규칙이 같이 처리). 여기에 두면 중복이다 -->


  <!-- 캡션 3버튼(Grid#PdCaptionOps — Themes/CaptionButtons.axaml): 위 PdCaptionStrip 규칙과 같은 흐림 -->
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PdCaptionOps Path"><Setter Property="Fill" Value="{DynamicResource PdChromeGlyphInactive}" /></Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PdCaptionOps Button.pdCap:pointerover Path"><Setter Property="Fill" Value="{DynamicResource PdChromeGlyphHoverInactive}" /></Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PdCaptionOps Button.pdCap:pressed Path"><Setter Property="Fill" Value="{DynamicResource PdChromeGlyphPressedInactive}" /></Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PdCaptionOps Button.pdCap.pdClose:pointerover Path">
    <Setter Property="Fill" Value="{DynamicResource PdChromeCloseGlyphHoverInactive}" />
  </Style>
  <Style Selector="controls|MdiDocumentWindow:not(:active) /template/ Grid#PdCaptionOps Button.pdCap.pdClose:pressed Path">
    <Setter Property="Fill" Value="{DynamicResource PdChromeCloseGlyphPressedInactive}" />
  </Style>
</Styles>
