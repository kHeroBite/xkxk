<!-- SDI 호스트 창 테마(UI-09) — Dock HostWindow 재정의: 문서 창이면 OS 제목줄을 감추고(BorderOnly) 앱 제목줄(Views/SdiTitleBar)을 그린다. macOS 네이티브 신호등은 SdiTitleBar 가 창마다 Full 로 바꾼다(MacNativeCaption). MdiChrome.axaml 이 병합 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dmc="using:Dock.Model.Controls"
                    xmlns:views="using:xkxk.frameworks.ui.views" xmlns:views2m="using:xkxk.frameworks.ui.views" xmlns:views1m="using:xkxk.frameworks.ui.Controls">
  <IntLessThanConverter x:Key="PdLessThan2" TrueIfLessThan="2" />
  <!-- SDI(OS 실 창): 문서 창이면 OS 제목줄을 감추고 같은 제목줄(Views/SdiTitleBar)을 그린다. 모서리·그림자는 OS(DWM)가 그린다 -->
  <ControlTheme x:Key="{x:Type HostWindow}" TargetType="HostWindow" x:DataType="dmc:IRootDock">
    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />
    <Setter Property="(DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(DockProperties.DockGroup)" Value="{Binding DockGroup}" />
    <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DockTabForegroundBrush}" />
    <Setter Property="Title" Value="{Binding FocusedDockable.Title}" />
    <Setter Property="Topmost" Value="{Binding Window.Topmost}" />
    <Setter Property="WindowDecorations" Value="Full" />
    <Setter Property="ExtendClientAreaToDecorationsHint" Value="False" />
    <Setter Property="ToolChromeControlsWholeWindow" Value="{Binding OpenedDockablesCount, Converter={StaticResource PdLessThan2}}" />
    <!-- U9 ⑩ 최소 크기(odev-ux 발견: 1×1 까지 줄어 제목줄이 사라짐) — 값은 Docking/WindowMinSize.cs 가 크롬 스타일에 맞춰 앱 리소스로 건다(기본 0 = ChromeResources) -->
    <Setter Property="MinWidth" Value="{DynamicResource PdWindowMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource PdWindowMinHeight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <VisualLayerManager Name="PART_VisualLayerManager">
            <DeferredContentPresenter Name="PART_ContentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" />
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Setter Property="Content" Value="{Binding}" />
    <Setter Property="ContentTemplate">
      <DataTemplate x:DataType="dmc:IRootDock">
        <Panel Margin="{Binding $parent[HostWindow].OffScreenMargin}">
          <OverlayHost VisualTreeLifecycleBehavior.IsEnabled="True">
            <DockControl Layout="{Binding}" />
          </OverlayHost>
        </Panel>
      </DataTemplate>
    </Setter>

    <Style Selector="^:toolwindow:toolchromecontrolswindow">
      <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
      <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
      <Setter Property="WindowDecorations" Value="BorderOnly" />
    </Style>
    <!-- Dock 12.1.0.12 HostWindow 는 :documentwindow 를 그립(tab strip) 부착 때만 켠다(HostWindow.axaml.cs 실측) → 도구 창이 아니면 문서 창으로 본다 -->
    <Style Selector="^:not(:toolwindow)">
      <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
      <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
      <Setter Property="WindowDecorations" Value="BorderOnly" />
      <Setter Property="ContentTemplate">
        <DataTemplate x:DataType="dmc:IRootDock">
          <Border Classes="pdSdiFrame" Margin="{Binding $parent[HostWindow].OffScreenMargin}"
                  BorderThickness="{DynamicResource PdSdiFrameThickness}" Padding="{DynamicResource PdChromeFramePadding}">
            <DockPanel>
              <views2m:SdiTitleBar DockPanel.Dock="Top" />
              <!-- 본문 바탕: 문서 뷰가 투명이라 없으면 틀의 제목줄 색이 비쳐 글자가 묻힌다. MDI 의 PART_ContentBorder 와 같은 토큰이다.
                   U8: OS(DWM) 둥근 창 모서리 안에서 띠 두께가 같도록 본문 아래 모서리도 둥글린다(최대화는 MdiChrome.axaml 이 0) -->
              <views1m:ClipBorder Classes="pdSdiContent" Background="{DynamicResource PdBrushSurface}" CornerRadius="{DynamicResource PdChromeContentCorner}">
                <OverlayHost VisualTreeLifecycleBehavior.IsEnabled="True">
                  <DockControl Layout="{Binding}" />
                </OverlayHost>
              </views1m:ClipBorder>
            </DockPanel>
          </Border>
        </DataTemplate>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
